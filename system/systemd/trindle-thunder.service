# Asks the person at the screen before a Thunderbolt or USB4 device
# connects, and lets in by itself the ones they allowed always. Started by
# udev (90-trindle-thunder.rules) once the computer shows a Thunderbolt or
# USB4 controller, so a computer without one never runs it.
[Unit]
Description=Ask before Thunderbolt and USB4 devices connect
After=systemd-udevd.service systemd-logind.service

[Service]
ExecStart=/usr/lib/trindle/libexec/trindle-thunder
Restart=on-failure
RestartSec=1
# Root, to write the kernel's authorized and key files, but with only one
# power kept: reading the lock mark in the person's own runtime folder.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
StateDirectory=trindle-thunder
StateDirectoryMode=0700
RuntimeDirectory=trindle-thunder
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
# /run/user is read for the lock mark; nothing in a home is touched.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# The socket for the session, and the kernel's news of devices.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
