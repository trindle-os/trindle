# Lets go of external USB hubs cleanly just before a restart, so a hub that
# keeps its own power through a warm restart is not left in a bad state. Wanted
# by the restart targets only, never by power-off or halt, so those are not
# slowed; it is given five seconds at most. A computer without a USB bus never
# runs it.
[Unit]
Description=Let go of external USB hubs before a restart
DefaultDependencies=no
ConditionPathExists=/sys/bus/usb/devices
Before=umount.target

[Service]
Type=oneshot
ExecStart=/usr/lib/trindle/libexec/trindle-usb-retry --before-restart
TimeoutStartSec=5
# Writes only to the hubs' own files in /sys, which a plain root may do.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/sys/devices
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
IPAddressDeny=any

[Install]
WantedBy=reboot.target kexec.target
