# Keeps out everything from other computers that this one did not ask for,
# put in place before the network comes up. Shared folders and printers are
# let in only while that is switched on in Settings, Network.
[Unit]
Description=Keep out connections this computer did not ask for
DefaultDependencies=no
Before=network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/trindle/libexec/trindle-admin firewall-apply

[Install]
WantedBy=multi-user.target
