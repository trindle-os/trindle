# Once a day, and a while after each start for a computer that is off at
# night. The look itself takes no second copy within twenty hours.
[Unit]
Description=Trindle: earlier versions of everyone's files, once a day

[Timer]
OnCalendar=daily
OnBootSec=15min
RandomizedDelaySec=30min
AccuracySec=30min
Persistent=true

[Install]
WantedBy=timers.target
