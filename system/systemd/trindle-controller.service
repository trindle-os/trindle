# Makes game controllers (pads and joysticks only, never a keyboard or mouse) for the compositor, through /dev/uinput, which only root may open.
[Unit]
Description=Make game controllers for the compositor
Requires=trindle-controller.socket
After=trindle-controller.socket

[Service]
ExecStart=/usr/lib/trindle/libexec/trindle-controller
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/uinput rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateIPC=yes
ReadOnlyPaths=/proc
InaccessiblePaths=-/run/user -/dev/shm
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~setuid setgid setreuid setregid setresuid setresgid setgroups ptrace process_vm_readv process_vm_writev
SystemCallErrorNumber=EPERM
UMask=0077
TasksMax=2
MemoryMax=32M
LimitNOFILE=64
