# Tries a USB port that failed to start ("unable to enumerate USB device") once more, by switching it off and on, and notes it for Settings.
[Unit]
Description=Try a USB port that failed to start once more
ConditionPathExists=/sys/bus/usb/devices
After=systemd-udevd.service

[Service]
ExecStart=/usr/lib/trindle/libexec/trindle-usb-retry
Restart=on-failure
RestartSec=5
CapabilityBoundingSet=CAP_SYSLOG
AmbientCapabilities=CAP_SYSLOG
RuntimeDirectory=trindle-usb-retry
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/sys/devices -/sys/bus/pci/drivers/xhci_hcd
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/kmsg r
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
