# Only these packages come from trixie-backports; apt never picks anything
# else from it by itself (priority 1). The kernel is never one of them: it is
# Debian stable's (a newer kernel froze the desktop, so there is no
# backports kernel and no choice of one). The firmware-linux
# meta packages are named, or stable's pin the old firmware.
Package: *
Pin: release n=trixie-backports
Pin-Priority: 1

Package: firmware-linux firmware-linux-nonfree firmware-linux-free firmware-mediatek firmware-realtek firmware-iwlwifi firmware-atheros firmware-brcm80211 firmware-libertas firmware-ti-connectivity firmware-amd-graphics firmware-intel-graphics firmware-intel-misc firmware-misc-nonfree firmware-nvidia-graphics firmware-intel-sound firmware-cirrus firmware-samsung firmware-siano
Pin: release n=trixie-backports
Pin-Priority: 800
