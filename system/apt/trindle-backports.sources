# Debian's backports for the current release: newer
# firmware, nothing else. trindle-backports.pref keeps every other package
# on Debian stable, so this source offers only what that file names.
Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie-backports
Components: main non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
