#!/bin/sh
# The turning Trindle mark, from the moment there is a screen until the login screen or the desktop takes it over.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in
    prereqs) prereqs; exit 0 ;;
esac

[ -x /usr/bin/trindle-unlock ] || exit 0
case " $(cat /proc/cmdline) " in
    *" nosplash "*) exit 0 ;;
esac
/usr/bin/trindle-unlock --spin </dev/null >/dev/null 2>&1 &
exit 0
