#!/bin/sh
# The parts that belong to the stick only; the installer takes them out again.
set -e
user=trindle

mkdir -p /etc/trindle
cat > /etc/trindle/greetd.toml <<'CONF'
[terminal]
vt = 7

[default_session]
command = "/usr/bin/trindle-greeter-session"
user = "_greetd"

[initial_session]
command = "/usr/bin/trindle-session"
user = "trindle"
CONF

mkdir -p /etc/sudoers.d /usr/local/share/applications
printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$user" > /etc/sudoers.d/live
chmod 440 /etc/sudoers.d/live

cat > /usr/local/share/applications/trindle-installer.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=Install
Comment=Put Trindle on this computer's own disk
Exec=trindle-installer
Icon=trindle
Terminal=false
Categories=System;
DESK

mkdir -p /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/trindle-live-welcome.desktop <<'AUTO'
[Desktop Entry]
Type=Application
Name=Welcome to Trindle
Exec=trindle-live-welcome
Terminal=false
AUTO

mkdir -p /etc/skel/.config/trindle
if ! grep -qs trindle-installer /etc/skel/.config/trindle/favourites; then
    printf 'trindle-installer.desktop\n' >> /etc/skel/.config/trindle/favourites
fi

printf 'clipboard_forget=reboot\nlock=off\ntheme=dark\n' >> /etc/skel/.config/trindle/trindle.conf

if ! id "$user" >/dev/null 2>&1; then
    useradd -m -s /bin/bash -c "Trindle" \
        -G sudo,audio,video,input,netdev,plugdev,cdrom,dialout,lpadmin "$user"
fi
passwd -l "$user"

rm -f /var/cache/apt/*.bin
