# The desktop itself comes from the Trindle package's own Depends, which are
# built from packages.txt, so nothing is restated here and the two cannot drift.

# The kernel: Debian stable's (signed by Debian, so Secure Boot needs no key
# step); the pin file never lets the backports one in. The firmware
# and driver packages are listed once, in system/apt/hardware-packages.txt,
# and tools/iso/build.sh makes their list from it.
linux-image-amd64

# Running from the stick.
sudo
live-boot live-config live-config-systemd

# What the installer needs to write a disk.
parted dosfstools e2fsprogs btrfs-progs ntfs-3g rsync cryptsetup cryptsetup-initramfs
clevis clevis-luks clevis-initramfs clevis-tpm2 tpm2-tools os-prober snapper busybox
grub-efi-amd64 grub-efi-amd64-signed grub-pc-bin shim-signed efibootmgr
