<?xml version="1.0"?>
<!-- Trindle's keyboard shortcuts and window settings, read by its compositor.
     Installed for everyone; ~/.config/trindle/shortcuts.xml, if there is one,
     is merged over it. The list attribute names the words the shortcut
     list (Super+K) shows for a key; a keybind without one fails a test. -->
<trindle_desktop>

  <core>
    <gap>6</gap>
  </core>

  <theme>
    <cornerRadius>10</cornerRadius>
  </theme>

  <keyboard>
    <repeatRate>30</repeatRate>
    <repeatDelay>400</repeatDelay>
    <default />
    <keybind key="Super_L" list="ring" onRelease="yes"><action name="Execute" command="trindle-ring" /></keybind>
    <keybind key="W-space" list="ring"><action name="Execute" command="trindle-ring" /></keybind>
    <keybind key="W-Return" list="terminal"><action name="Execute" command="trindle-terminal" /></keybind>
    <keybind key="C-A-t" list="terminal"><action name="Execute" command="trindle-terminal" /></keybind>
    <keybind key="W-i" list="settings"><action name="Execute" command="trindle-settings" /></keybind>
    <keybind key="W-q" list="close"><action name="Close" /></keybind>
    <keybind key="W-l" list="lock"><action name="Execute" command="trindle-lock" /></keybind>
    <!-- Every window put away to show the desktop, and back again, as on
         Windows and GNOME. -->
    <keybind key="W-d" list="desktop"><action name="Execute" command="trindle-ring --show-desktop" /></keybind>
    <!-- The keyboard into the notification circles: Tab between their buttons, Enter or Space to press, Escape to leave. -->
    <keybind key="W-n" list="notes"><action name="Execute" command="trindle-ring --notes" /></keybind>
    <!-- Activity, the task manager, on the keys Windows uses for its own. -->
    <keybind key="C-S-Escape" list="activity"><action name="Execute" command="trindle-activity" /></keybind>
    <!-- The screen reader, on the same keys as GNOME's. -->
    <keybind key="W-A-s" list="reader"><action name="Execute" command="trindle-settings --screen-reader" /></keybind>
    <keybind key="W-Up" list="maximise"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Down" list="minimise"><action name="Iconify" /></keybind>
    <keybind key="Print" list="screenshot"><action name="Execute" command="trindle-screenshot" /></keybind>
    <keybind key="W-S-s" list="screenshot"><action name="Execute" command="trindle-screenshot" /></keybind>
    <keybind key="S-Print" list="screenshot-whole"><action name="Execute" command="trindle-screenshot --whole" /></keybind>
    <keybind key="XF86AudioRaiseVolume" list="volume-up"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume" list="volume-down"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute" list="mute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86AudioMicMute" list="mic-mute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" /></keybind>
    <keybind key="XF86MonBrightnessUp" list="brightness-up"><action name="Execute" command="trindle-brightness up" /></keybind>
    <keybind key="XF86MonBrightnessDown" list="brightness-down"><action name="Execute" command="trindle-brightness down" /></keybind>
  </keyboard>

  <mouse>
    <default />
    <!-- A double click (or a double tap) on the empty desktop opens the
         ring. A single click there, left, middle or right, opens nothing. -->
    <context name="Root">
      <mousebind button="Left" action="DoubleClick"><action name="Execute" command="trindle-ring" /></mousebind>
    </context>
  </mouse>

</trindle_desktop>
