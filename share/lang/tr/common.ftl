# Why a plugin's port line in plugin.ini is refused. { $text } is what was written.
common-firewall-not-protocol-port = "{ $text }" protokol:bağlantı noktası biçiminde yazılmamış, örneğin tcp:24810.

# Why a plugin's port line in plugin.ini is refused. { $text } is what was written before the colon.
common-firewall-bad-protocol = "{ $text }" tcp ya da udp değil. Küçük harflerle yazın.

# Why a plugin's port line in plugin.ini is refused. { $text } is what was written, { $lowest } the lowest port allowed.
common-firewall-bad-port = "{ $text }", { $lowest } ile 65535 arasında bir bağlantı noktası değil.

# Said when a port you open by hand isn't written as protocol:port.
common-firewall-own-form = protokol:bağlantı noktası biçiminde yazın, örneğin tcp:37666.

# Said when a port you open by hand starts with something other than tcp or udp.
common-firewall-own-protocol = tcp ya da udp kullanın.

# Said when a port you open by hand isn't a number from 1 to 65535.
common-firewall-own-port = Bu, 1 ile 65535 arasında bir bağlantı noktası değil.

# Joins the last port to the others in a list of ports. { $first } is the others, comma separated.
common-firewall-and = { $first } ve { $last }

# Heads a list of ports. { $count } is how many, { $list } is the ports, such as TCP 24810 and UDP 24811.
common-firewall-ports =
    { $count ->
        [one] Bağlantı noktası { $list }
       *[other] Bağlantı noktaları { $list }
    }

# Why a plugin's ports are refused. { $max } is the most it may name.
common-firewall-too-many = Bir eklenti en fazla { $max } bağlantı noktası belirtebilir.

# Why a plugin's ports are refused. { $port } is a port such as TCP 24810.
common-firewall-twice = { $port } iki kez belirtilmiş.

# Why a plugin's ports are refused. { $port } is a port such as TCP 80, { $lowest } the lowest allowed.
common-firewall-too-low = { $port }, { $lowest } değerinin altında. Bu bağlantı noktaları sistem için ayrılmıştır.

# Why a plugin's port is refused. { $port } is the number.
common-firewall-reserved = { $port } numaralı bağlantı noktasını Trindle ya da yaygın bir hizmet kullanıyor, bu yüzden bir eklenti onu isteyemez.

# Why a plugin's port can't be opened. { $port } is such as TCP 24810, { $plugin } is the other plugin's name.
common-firewall-taken = { $port } zaten { $plugin } tarafından kullanılıyor, bu yüzden bu eklenti için de açılamaz.

# Why a plugin cannot open another port: { $max } is how many may be open.
common-firewall-full = Eklentiler için açılabilecek en fazla bağlantı noktası olan { $max } zaten açık.

