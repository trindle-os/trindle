
# machine translated (Turkish), not yet reviewed by a person.

# Name of the Settings page about event sounds, in the list and as its heading.
settings-sounds-title = Sesler

# Words a person might type into the Settings search to find the sounds page; separate them with spaces.
settings-sounds-keywords = ses sesler çan açılış başlangıç oturum aç oturum kapat kapat kapanış şarj cihazı takıldı çıkarıldı pil uyarı bip kapalı sessiz kendi özel ekle dosya wav ogg mp3

# Introduction under the heading of the sounds page, and the words behind the page i.
settings-sounds-help = Oturum açma gibi her an için bir ses seçin. Kendi seslerinizi de ekleyebilirsiniz.

# First choice in each moment's list of sounds: that moment makes no sound.
settings-sounds-off = Kapalı

# Sentence at the top of the page when no moment makes a sound.
settings-sounds-top-none = Her şey sessiz.

# Sentence at the top of the page when every moment makes a sound.
settings-sounds-top-all = Tüm sesler açık.

# Sentence at the top of the page when some moments make a sound; { $n } is how many of the { $total } do.
settings-sounds-top-some =
    { $n ->
        [one] { $total } sesten { $n } tanesi açık. Diğerleri kapalı.
       *[other] { $total } sesten { $n } tanesi açık. Diğerleri kapalı.
    }

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-open = Trindle açılıyor

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-close = Trindle kapanıyor

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-sunrise = Gün doğumu

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-sunset = Gün batımı

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-rising = Yükselen

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-falling = Alçalan

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-alert = Uyarı

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-bell = Çan

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-glass = Cam

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-pop = Pop

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-login = Oturum açma

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-logout = Oturum kapatma, yeniden başlatma ve kapatma

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-plug = Şarj cihazı takıldı

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-unplug = Şarj cihazı çıkarıldı

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-battery = Pil azaldı

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-notification = Bir bildirim belirir

# Heading of the logging out line.
settings-sounds-moment-logout-short = Oturum kapatma

# Heading of the notifications line.
settings-sounds-moment-notification-short = Bildirimler

# Small words under the logging out line.
settings-sounds-moment-logout-about = Yeniden başlatma ve kapatma da.

# Heading and slider name for the volume of the logging in and out sounds.
settings-sounds-volume-coming = Oturum açma ve kapatma ses düzeyi

# Heading and slider name for the volume of notification sounds.
settings-sounds-volume-notifications = Bildirimlerin sesi

# Heading and slider name for the volume of the charger and battery sounds.
settings-sounds-volume-power = Güç seslerinin düzeyi

# Name of the round button that plays the sound chosen for a moment, or an added sound.
settings-sounds-hear = Çal

# Name of the button that opens a window to add sound files.
settings-sounds-add = Ses dosyaları ekle

# Name of the button that opens the folder where added sounds are kept.
settings-sounds-open-folder = Eklenen seslerin klasörünü aç

# Red words under the add sounds line when the folder could not be opened.
settings-sounds-folder-not-opened = Klasör açılamadı.

# Red words under the add sounds line when the folder for added sounds could not be made.
settings-sounds-folder-not-made = Trindle sesleriniz için klasörü oluşturamadı.

# Name of the button that plays the sound being added, when one of the same name is already there.
settings-sounds-hear-new = Yeni sesi çal

# Name of the button that plays the sound already there, when one of the same name is being added.
settings-sounds-hear-old = Var olan sesi çal

# Heading of the line for adding sounds.
settings-sounds-add-heading = Ses ekle

# Name of the bin button that removes a sound added by the person.
# SAFETY: needs a human review before it ships
settings-sounds-remove = Bu sesi kaldır

# Heading of the line shown when no sounds have been added.
settings-sounds-none-yet = Henüz eklenen yok

# Red words under a moment's line when its chosen sound file is gone.
settings-sounds-gone = Bu ses artık bu bilgisayarda yok. Başka bir tane seçin.

# Red words under a line when a sound would not play.
settings-sounds-would-not-play = Ses çalmadı. Ses bölümünde hoparlörlerinizi denetleyin.

# Title of the window for choosing sound files.
settings-sounds-chooser-title = Ses dosyalarını seçin

# Name of the filter in the window for choosing sound files that shows only sounds.
settings-sounds-chooser-filter = Sesler

# Red words under the add sounds line when a chosen file is not a sound; { $name } is the file name.
settings-sounds-not-playable = { $name } dosyasının türünü tanımadığı için Trindle onu çalamıyor.

# Red words under the add sounds line when a file could not be copied in; { $name } is the file name.
settings-sounds-not-copied = { $name } kopyalanamadı.

# Green words under the add sounds line after sounds were added; { $n } is how many.
settings-sounds-added =
    { $n ->
        [one] { $n } ses eklendi. Artık bunu yukarıdaki herhangi bir an için seçebilirsiniz.
       *[other] { $n } ses eklendi. Artık bunları yukarıdaki herhangi bir an için seçebilirsiniz.
    }

# Red words under the question about a sound of the same name when it could not be replaced; { $name } is the file name.
settings-sounds-not-replaced = { $name } değiştirilemedi.

# Green words after one sound took the place of the one there; { $name } is the file name.
settings-sounds-replaced-one = { $name } değiştirildi.

# Green words after several sounds took the place of the ones there; { $n } of { $total } were done.
settings-sounds-replaced-some = { $total } sesten { $n } tanesi değiştirildi.

# Red words under a sound's line when it could not be removed.
# SAFETY: needs a human review before it ships
settings-sounds-not-removed = Kaldırılamadı.

# Red words under a moment's line when its sound was removed and the moment could not be set back to its own sound.
# SAFETY: needs a human review before it ships
settings-sounds-not-set-back = Trindle sesi kaldırdı ama o an için olağan sesi geri koyamadı.

# Title of the card with the sounds for logging in and out and notifications.
settings-sounds-coming-title = Oturum açma ve kapatma

# Words behind the i of that card.
settings-sounds-coming-about = Her ses düzeyi 0'dan 100'e onar onar gider. Bıraktığınızda sesi bir kez duyarsınız.

# Title of the card with the charger and battery sounds.
settings-sounds-power-title = Güç

# Words behind the i of that card.
settings-sounds-power-about = Şarj cihazını takma ve çıkarma ile pilin azalması için sesler. Ses düzeyi 0'dan 100'e onar onar gider. Bıraktığınızda sesi bir kez duyarsınız.

# Title of the card with the sounds the person added.
settings-sounds-own-title = Kendi sesleriniz

# Words behind the i of that card.
settings-sounds-own-about = WAV, OGG, Opus, FLAC veya MP3. Trindle bunları kendi klasörünüze kopyalar, böylece asılları taşıyabilir veya silebilirsiniz. Sonra bunları diğerleri gibi herhangi bir an için seçebilirsiniz. Birini kaldırırsanız onu kullanan her an olağan sesine geri döner.
