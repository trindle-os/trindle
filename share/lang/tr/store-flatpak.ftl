# machine translated (Turkish), not yet reviewed by a person.

# The page shown before a Flatpak program is installed, with what it will be able to reach.
# Headline over the page; the source of the program is given.
store-fp-headline-from = { $name }, { $host } kaynağından kurulsun mu?

# Headline over the page for a program that has been downloaded.
store-fp-headline = { $name } kurulsun mu?

# Name of the card that lists what the program will be able to reach.
store-fp-card = Nelere ulaşabilecek

# Tooltip of the round button that leaves without installing.
store-fp-cancel = Kurma

# The main button.
store-fp-install = Kur

# Said while Flatpak is being asked what the program wants.
store-fp-reading = İstedikleri okunuyor…

# Red words when what the program asks for could not be read.
store-fp-unread = Trindle neler istediğini okuyamadı.

# Red words after Install was pressed once for a program whose list could not be read.
store-fp-unread-again = Devam etmek için Kur'a yeniden basın.

# Said when the program is already on this computer; the name is given.
store-fp-have = { $name } zaten kurulu.

# Said when the program asks to reach nothing outside its own box.
store-fp-none = Kendi kutusunun dışında hiçbir şey yok.

# Each line below is one thing the program will be able to reach.
store-fp-network = İnternet ve yerel ağınız

store-fp-x11 = Başka uygulamaların pencereleri ve onlara yazdığınız şeyler

store-fp-sound = Ses ve mikrofonunuz

store-fp-devices = Kameranız ve takılı olan diğer tüm aygıtlar

store-fp-input = Oyun kolları ve diğer giriş aygıtları

store-fp-kvm = Hızlı sanal makineler

store-fp-shm = Başka uygulamalarla paylaşılan bellek

store-fp-usb = USB aygıtları

store-fp-canbus = CAN bus aygıtları

store-fp-cups = Yazıcılarınız

store-fp-multiarch = 32 bit programları çalıştırma

store-fp-escape = Bu bilgisayardaki her programı çalıştır

# A reference that also adds a second place to get apps from, named by its address.
store-fp-adds-source = { $host } adresini uygulama kaynaklarınıza ekle

# Last line, when the program asks for more than the lines above say.
store-fp-other = Ayrıca başka ayarlar

store-fp-bluetooth = Bluetooth aygıtları

store-fp-smartcard = Akıllı kartlar

store-fp-ssh = SSH anahtarlarınız

store-fp-gpg = GPG anahtarlarınız

store-fp-devel = Başlattığı programları izlemesine ve denetlemesine izin veren hata ayıklama araçları

store-fp-session-bus = Oturumunuzda çalışan her program

store-fp-system-bus = Bu bilgisayardaki her hizmet

# A place the program can open and change; the place is given, as below.
store-fp-files = { $what } konumunu aç ve değiştir

# The same for a place it can only look at.
store-fp-files-read = { $what } konumuna bak

store-fp-where-host = bu bilgisayardaki her dosya

store-fp-where-system = bu bilgisayarın sistem dosyaları

store-fp-where-home = gizli dosyalar dahil tüm ev klasörünüz

store-fp-where-path = { $path } klasörü

# A program on your session that it can talk to; the name is given.
store-fp-talk = { $name } ile konuş

# A service the program runs on your session.
store-fp-own = { $name } hizmetini çalıştır

store-fp-talk-system = { $name } sistem hizmetiyle konuş

store-fp-own-system = { $name } sistem hizmetini çalıştır

# Said in red when Install failed and taking the program out again failed too.
store-fp-undo-failed = Yarım kurulmuş olabilir.

# Said in red when a bundle could not be copied for a safe read.
store-fp-copy-failed = Dosya güvenle okunmak üzere kopyalanamadı.
