# Apps: the page of one AppImage (src/store/pages/image_page.rs).

# Name of the line of Facts that says how many people starred the project on GitHub.
store-image-fact-stars = Stars
# Name of the line of Facts that says how many files the newest release holds.
store-image-fact-files = Files
# Name of the card listing the files of the newest release.
store-image-files = Files
# In the Files card while GitHub is being asked.
store-image-files-looking = Looking for its files…
# In the Files card when the project has nothing to install on this computer, or GitHub did not say.
store-image-files-none = No files for this computer are listed.
# In the Files card for a project that is not on GitHub, so its files are not listed.
store-image-files-site = Its files are on its website.
