## Licences card

# Where to read the licence of an included work, behind the info button of the Licences card on the Thanks page (paths are file names).
settings-thanks-where-copyright = Read it in /usr/share/doc/trindle/copyright and THIRD-PARTY.txt.
# Name of an included work in the Licences card on the Thanks page: "The compositor".
settings-thanks-included-the-compositor-name = The compositor
# What the included work "The compositor" is in Trindle and its licence, the line under its name in the Licences card.
settings-thanks-included-the-compositor = Began from anvil, Smithay's example compositor. MIT.
# Name of an included work in the Licences card on the Thanks page: "Smithay 0.7.0".
settings-thanks-included-smithay-0-7-0-name = Smithay 0.7.0
# What the included work "Smithay 0.7.0" is in Trindle and its licence, the line under its name in the Licences card.
settings-thanks-included-smithay-0-7-0 = Kept in Trindle's source, with its changes listed. MIT.
# Where to read the licence of "Smithay 0.7.0", behind the info button of the Licences card.
settings-thanks-included-smithay-0-7-0-where = Kept inside Trindle's source in vendor/smithay, with Trindle's changes listed beside it. Read it in vendor/smithay/LICENSE.txt and THIRD-PARTY.txt.
# Name of an included work in the Licences card on the Thanks page: "Screen helpers".
settings-thanks-included-screen-helpers-name = Screen helpers
