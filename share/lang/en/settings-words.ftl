# Settings, Language, Your own words: the card for a word sheet of your own.

# The card's heading.
settings-words-heading = Your own words
# Under the heading.
settings-words-about = Change any word Trindle shows, in any language, and share the sheet as a file.
# The first line of the card: what is locked, in plain words.
settings-words-rule = A sheet changed anywhere but its last column, or not Trindle's own, is rejected whole.
# Under the rule on the card: when changed words appear.
settings-words-next-start = Your words show the next time a program starts.
# The line that picks which language the boxes are for.
settings-words-language = Language
# Under the language line.
settings-words-language-sub = The sheet is for this language.
# The name of the language list for the screen reader.
settings-words-language-tip = Language of the sheet
# The line that starts a language of your own, and its button's tip.
settings-words-start = Start a language of your own
# Under the start line.
settings-words-start-sub = Name it, real or made up. It starts as English.
# Inside the empty name box, and its name for the screen reader.
settings-words-name-tip = Name of your language
# Beside the start line when the language was made.
settings-words-started = Started
# Under the start line: the name is empty or too long.
settings-words-name-length = Use 1 to 30 letters
# Under the start line: the name holds markup, a path or hidden characters.
settings-words-name-plain = Letters only: no markup, paths or hidden characters
# Under the start line: another language of your own has this name.
settings-words-name-taken = You already have a language of that name
# A language of your own in the language lists. { $name } is the name the person gave it.
settings-words-own-label = { $name } (your own)
# The line with the search box.
# Under the search line.
# The name of the search box for the screen reader.
# The name of a translation box for the screen reader.
# The line that exports the sheet, and its button's tip.
settings-words-export = Download the sheet
# Under the export line.
settings-words-export-sub = English on the left, your language on the right.
# Title of the window that asks where to save the sheet.
settings-words-export-title = Save the word sheet
# The line that imports a sheet, and its button's tip.
settings-words-import = Upload the sheet
# Under the import line.
settings-words-import-sub = Checked whole first. Any difference installs nothing.
# Title of the window that asks which sheet to open.
settings-words-import-title = Open a word sheet
# Under the import button when a sheet was installed.
settings-words-imported = Installed
# Under a box or the export button when the words could not be kept.
settings-words-not-saved = Could not be saved
# Under the import button: the file is bigger than any sheet.
settings-words-too-big = Rejected: the file is too big
# Under the import button: the file is not text.
settings-words-not-text = Rejected: not plain text
# Under the import button: the file holds control or hidden characters.
settings-words-not-plain = Rejected: hidden or control characters
# Under the import button: a line is longer than any line of a sheet.
settings-words-line-long = Rejected: a line is too long
# Under the import button: the file is not a Trindle word sheet.
settings-words-not-mine = Rejected: not a Trindle word sheet
# Under the import button: the sheet is of another version.
settings-words-version = Rejected: another version of the sheet
# Under the import button: the language tag is not usable.
settings-words-bad-language = Rejected: the language is not valid
# Under the import button: the check value does not match what Trindle wrote.
settings-words-check-value = Rejected: the check value does not match
# Under the import button: the notes at the top were changed.
settings-words-notes = Rejected: the top of the sheet was changed
# Under the import button: lines are missing or extra.
settings-words-count = Rejected: lines are missing or extra
# Under the import button: a key is not the one Trindle has. The key is { $key }.
settings-words-key = Rejected: the key at { $key } was changed
# Under the import button: an English line was changed. The key is { $key }.
settings-words-english = Rejected: the English of { $key } was changed
# Under the import button: a row is not in the right form. The key is { $key }.
settings-words-shape = Rejected: the row of { $key } is not in the right form
# Under a box or the import button: the translation is too long. The key is { $key }.
settings-words-long = Rejected: the words for { $key } are too long
# Under a box or the import button: the translation holds hidden or control characters. The key is { $key }.
settings-words-characters = Rejected: the words for { $key } hold hidden characters
# Under a box or the import button: the translation holds markup, a link or a path. The key is { $key }.
settings-words-links = Rejected: the words for { $key } hold markup, a link or a path
# Under a box or the import button: the translation's placeholders differ from the English. The key is { $key }.
settings-words-placeholders = Rejected: the placeholders of { $key } differ
# Under the import button: the file cannot be read as a plain file.
settings-words-not-sheet = Rejected: the file could not be read
# The line that puts the language back as it came, and its button's tip. Never taken from a sheet.
settings-words-reset = Back to Trindle's words
# Under the reset line for a language that came with Trindle. Never taken from a sheet.
settings-words-reset-sub = Puts it back as it came. Your words are kept as a backup.
# Under the reset line for a language of your own: the button asks twice. Never taken from a sheet.
settings-words-reset-own-sub = Removes this language of your own. Its words are kept in a backup folder.

# The button that opens the page where a finished sheet is offered for the next version.
settings-words-offer = Offer your sheet

# Under the offer button: who can send and why.
settings-words-offer-sub = Opens a page to sign in and send it. Never sent for you.
