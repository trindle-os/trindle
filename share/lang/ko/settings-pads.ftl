# machine translated (Korean), not yet reviewed by a person.

# Settings page "Game controllers": a picture of the controller that lights as it is pressed, a list of its buttons, and what each becomes.

# The page's name in the side bar.
settings-pads-title = 게임 컨트롤러

# The sentence at the top of the page when a controller is plugged in.
settings-pads-top-idle = 바꾸려면 컨트롤러의 버튼을 누르세요.
# The sentence at the top of the page when a button has been pressed; { $name } is the button.
settings-pads-top-picked = 이제 { $name }에 쓸 키를 누르세요.

# Heading of the line shown when no game controller is plugged in.
settings-pads-none = 연결된 것이 없어요
# Name of the list that chooses which controller is shown; { $title } is the one shown now.
settings-pads-which = 컨트롤러 선택
# What the picture is, for the screen reader.
settings-pads-picture = { $title } 그림. 버튼을 누르면 해당 버튼이 켜져요.

# Title of the card of the controller's buttons.
settings-pads-buttons-title = 버튼
# Words behind the i of that card.
settings-pads-buttons-about = 모든 버튼과 트리거, 스틱과 방향 패드의 모든 방향이에요. 마지막으로 누른 것이 맨 위에 있어요. 버튼을 키로 바꾸면, 컨트롤러를 지원하지 않는 게임에서 그 키가 입력돼요.
# Name of the round button that starts changing a button; { $name } is the button.
settings-pads-change = { $name }을(를) 키로 바꾸기
# Name of the round button that stops changing a button; { $name } is the button.
settings-pads-stop = { $name } 바꾸기 중지
# Name of the list of what a button becomes; { $name } is the button.
settings-pads-choose = { $name }의 동작
# What the list says while a button waits for its key: the clue, and a choice that does nothing.
settings-pads-waiting = 키를 누르거나 버튼을 고르세요
# The next choice in that list: the Escape key.
settings-pads-escape = Esc
# Where a choice in that list comes from; { $what } is the key, mouse button or controller button.
settings-pads-on-keyboard = 키보드: { $what }
settings-pads-on-mouse = 마우스: { $what }
settings-pads-on-pad = 게임 컨트롤러: { $what }
# The next choice in that list: nothing at all.
settings-pads-nothing = 없음
# The next choices in that list: the mouse buttons.
settings-pads-left-click = 왼쪽 클릭
settings-pads-right-click = 오른쪽 클릭
settings-pads-middle-click = 가운데 클릭
# Name of a way of the d-pad; { $way } is up, down, left or right.
settings-pads-dpad = 방향 패드 { $way }
# Name of a way of a stick; { $stick } is Left or Right and { $way } is up, down, left or right.
settings-pads-stick-way = { $stick } 스틱 { $way }
settings-pads-left = 왼쪽
settings-pads-right = 오른쪽
settings-pads-up = 위
settings-pads-down = 아래
# The two sticks, at the start of a name such as Left stick up.
settings-pads-stick-left = 왼쪽
settings-pads-stick-right = 오른쪽

# Title of the card of the ready-made changes.
settings-pads-quick-title = 자주 쓰는 변경
# Title of the card of changes that are not one button into another.
settings-pads-other-title = 다른 변경
# Words behind the i of that card.
settings-pads-other-about = 스틱을 뒤집거나 바꾸고, 데드존을 정할 수 있어요. 변경은 이렇게 입력하세요: Left Stick dead zone = 10%, 또는 Right Stick Y = inverted.

# Title of the card that chooses a profile for each game.
settings-pads-profiles-title = 프로필
# Words behind the i of that card.
settings-pads-profiles-about = 프로필은 변경 사항 모음이에요. 표준은 아무것도 바꾸지 않아서, 자체 컨트롤러 지원이 있는 게임은 컨트롤러를 있는 그대로 봐요. 여기서 프로필을 고르지 않으면 모든 Steam 게임이 표준을 써요. 게임이 시작되면 Trindle이 그 프로필로 바꿔요. 다른 모든 게임은 Steam이 시작하지 않은 게임이에요.
# The one switch that turns every controller change off at once.
settings-pads-changes = 컨트롤러 변경
# The game whose profile is shown.
settings-pads-game = 게임
settings-pads-other-game = 다른 모든 게임
settings-pads-game-running = { $name } (실행 중)
settings-pads-game-number = Steam 게임 { $n }
# The profile the shown game uses.
settings-pads-profile = 프로필
settings-pads-standard = 표준
settings-pads-profile-add = 프로필 추가
settings-pads-profile-remove = { $name } 삭제
settings-pads-profile-name = 프로필 이름
# The name a new profile is given.
settings-pads-profile-new = 프로필 { $n }
settings-pads-profile-empty = 프로필 이름을 입력하세요.
settings-pads-profile-standard = 표준은 이미 쓰고 있는 이름이에요.
settings-pads-profile-taken = 이미 쓰고 있는 이름이에요.
settings-pads-profile-gone = 그 프로필은 없어졌어요.
settings-pads-not-a-game = Steam 앱 번호가 아니에요.
# Why the buttons cannot be changed while the shown game uses Standard.
settings-pads-standard-why = 표준은 아무것도 바꾸지 않아요. 먼저 프로필을 추가하세요.
# The headline while the shown game uses Standard, and while all changes are off.
settings-pads-top-standard = 변경 없이 표준을 쓰는 중이에요.
settings-pads-top-off = 컨트롤러 변경이 꺼져 있어요.

# Heading of the line shown when the file of changed controller buttons could not be read.
settings-pads-unread = Trindle이 바꾼 버튼을 읽지 못했어요
# Small words under that line; { $why } is the reason.
settings-pads-unread-about = 그때까지 모든 버튼은 평소대로 작동하고 아무것도 저장되지 않아요. { $why }
# Shown beside a change that was not saved because the file of changed buttons could not be read.
settings-pads-not-saved-unread = 저장되지 않았어요. 바꾼 버튼 파일을 읽지 못해서 그대로 두었어요.
