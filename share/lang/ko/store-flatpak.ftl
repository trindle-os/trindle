# machine translated (Korean), not yet reviewed by a person.

# The page shown before a Flatpak program is installed, with what it will be able to reach.
# Headline over the page; the source of the program is given.
store-fp-headline-from = { $host }에서 { $name }을(를) 설치할까요?
# Headline over the page for a program that has been downloaded.
store-fp-headline = { $name }을(를) 설치할까요?
# Name of the card that lists what the program will be able to reach.
store-fp-card = 접근할 수 있게 되는 것
# Tooltip of the round button that leaves without installing.
store-fp-cancel = 설치 안 함
# The main button.
store-fp-install = 설치
# Said while Flatpak is being asked what the program wants.
store-fp-reading = 요청 내용을 읽는 중…
# Red words when what the program asks for could not be read.
store-fp-unread = Trindle이 요청 내용을 읽지 못했어요.
# Red words after Install was pressed once for a program whose list could not be read.
store-fp-unread-again = 계속하려면 설치를 다시 누르세요.
# Said when the program is already on this computer; the name is given.
store-fp-have = { $name }은(는) 이미 설치되어 있어요.
# Said when the program asks to reach nothing outside its own box.
store-fp-none = 자기 상자 밖의 것은 없어요.
# Each line below is one thing the program will be able to reach.
store-fp-network = 인터넷과 내 로컬 네트워크
store-fp-x11 = 다른 앱의 창과 그 안에서 입력하는 내용
store-fp-sound = 소리와 마이크
store-fp-devices = 카메라와 연결된 모든 기기
store-fp-input = 게임 컨트롤러와 다른 입력 장치
store-fp-kvm = 빠른 가상 머신
store-fp-shm = 다른 앱과 공유하는 메모리
store-fp-usb = USB 장치
store-fp-canbus = CAN 버스 장치
store-fp-cups = 내 프린터
store-fp-multiarch = 32비트 프로그램 실행
store-fp-escape = 이 컴퓨터의 모든 프로그램 실행
# A reference that also adds a second place to get apps from, named by its address.
store-fp-adds-source = 앱 소스에 { $host } 추가
# Last line, when the program asks for more than the lines above say.
store-fp-other = 그 밖의 설정
store-fp-bluetooth = Bluetooth 장치
store-fp-smartcard = 스마트 카드
store-fp-ssh = 내 SSH 키
store-fp-gpg = 내 GPG 키
store-fp-devel = 디버깅 도구. 자신이 시작한 프로그램을 보고 제어할 수 있어요
store-fp-session-bus = 내 세션에서 실행 중인 모든 프로그램
store-fp-system-bus = 이 컴퓨터의 모든 서비스
# A place the program can open and change; the place is given, as below.
store-fp-files = { $what } 열기 및 변경
# The same for a place it can only look at.
store-fp-files-read = { $what } 보기
store-fp-where-host = 이 컴퓨터의 모든 파일
store-fp-where-system = 이 컴퓨터의 시스템 파일
store-fp-where-home = 숨김 파일을 포함한 홈 폴더 전체
store-fp-where-path = { $path } 폴더
# A program on your session that it can talk to; the name is given.
store-fp-talk = { $name }와(과) 통신
# A service the program runs on your session.
store-fp-own = { $name } 서비스 실행
store-fp-talk-system = 시스템 서비스 { $name }와(과) 통신
store-fp-own-system = 시스템 서비스 { $name } 실행
# Said in red when Install failed and taking the program out again failed too.
store-fp-undo-failed = 일부만 설치되었을 수 있어요.
# Said in red when a bundle could not be copied for a safe read.
store-fp-copy-failed = 안전하게 읽기 위해 파일을 복사하지 못했어요.
