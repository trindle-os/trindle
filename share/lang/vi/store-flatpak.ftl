# machine translated (Vietnamese), not yet reviewed by a person.

# The page shown before a Flatpak program is installed, with what it will be able to reach.
# Headline over the page; the source of the program is given.
store-fp-headline-from = Cài { $name } từ { $host }?

# Headline over the page for a program that has been downloaded.
store-fp-headline = Cài { $name }?

# Name of the card that lists what the program will be able to reach.
store-fp-card = Nó sẽ truy cập được những gì

# Tooltip of the round button that leaves without installing.
store-fp-cancel = Không cài

# The main button.
store-fp-install = Cài

# Said while Flatpak is being asked what the program wants.
store-fp-reading = Đang đọc những gì nó yêu cầu…

# Red words when what the program asks for could not be read.
store-fp-unread = Trindle không đọc được những gì nó yêu cầu.

# Red words after Install was pressed once for a program whose list could not be read.
store-fp-unread-again = Nhấn Cài lần nữa để tiếp tục.

# Said when the program is already on this computer; the name is given.
store-fp-have = { $name } đã được cài.

# Said when the program asks to reach nothing outside its own box.
store-fp-none = Không có gì ngoài phạm vi riêng của nó.

# Each line below is one thing the program will be able to reach.
store-fp-network = Internet và mạng nội bộ của bạn

store-fp-x11 = Cửa sổ của các ứng dụng khác, và những gì bạn gõ trong đó

store-fp-sound = Âm thanh và micrô của bạn

store-fp-devices = Camera của bạn và mọi thiết bị khác đang cắm vào

store-fp-input = Tay cầm chơi game và các thiết bị nhập khác

store-fp-kvm = Máy ảo chạy nhanh

store-fp-shm = Bộ nhớ dùng chung với các ứng dụng khác

store-fp-usb = Thiết bị USB

store-fp-canbus = Thiết bị CAN bus

store-fp-cups = Máy in của bạn

store-fp-multiarch = Chạy chương trình 32 bit

store-fp-escape = Chạy bất kỳ chương trình nào trên máy tính này

# A reference that also adds a second place to get apps from, named by its address.
store-fp-adds-source = Thêm { $host } vào nguồn ứng dụng của bạn

# Last line, when the program asks for more than the lines above say.
store-fp-other = Cùng các thiết lập khác

store-fp-bluetooth = Thiết bị Bluetooth

store-fp-smartcard = Thẻ thông minh

store-fp-ssh = Khóa SSH của bạn

store-fp-gpg = Khóa GPG của bạn

store-fp-devel = Công cụ gỡ lỗi, cho phép nó theo dõi và điều khiển các chương trình do nó khởi chạy

store-fp-session-bus = Mọi chương trình đang chạy trong phiên của bạn

store-fp-system-bus = Mọi dịch vụ trên máy tính này

# A place the program can open and change; the place is given, as below.
store-fp-files = Mở và thay đổi { $what }

# The same for a place it can only look at.
store-fp-files-read = Xem { $what }

store-fp-where-host = mọi tệp trên máy tính này

store-fp-where-system = các tệp hệ thống của máy tính này

store-fp-where-home = toàn bộ thư mục chính của bạn, gồm cả tệp ẩn

store-fp-where-path = thư mục { $path }

# A program on your session that it can talk to; the name is given.
store-fp-talk = Trao đổi với { $name }

# A service the program runs on your session.
store-fp-own = Chạy dịch vụ { $name }

store-fp-talk-system = Trao đổi với dịch vụ hệ thống { $name }

store-fp-own-system = Chạy dịch vụ hệ thống { $name }

# Said in red when Install failed and taking the program out again failed too.
store-fp-undo-failed = Có thể nó mới được cài một phần.

# Said in red when a bundle could not be copied for a safe read.
store-fp-copy-failed = Không sao chép được tệp để đọc an toàn.
