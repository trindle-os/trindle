settings-help-topics-users-keywords = utilisateurs comptes personnes mot de passe image photo avatar administrateur ajouter supprimer

# SAFETY: needs a human review before it ships
# Help topic "People, passwords and pictures": paragraph 1.
settings-help-topics-users-p1 = Ouvrez Réglages et choisissez Utilisateurs. Vous pouvez changer votre mot de passe, choisir une image de vous qui apparaît à l'écran de connexion, et ajouter des comptes pour d'autres personnes.

# Help topic "People, passwords and pictures": caption and spoken name of picture 2 (settings-users.png).
settings-help-topics-users-pic2 = La page Utilisateurs

# SAFETY: needs a human review before it ships
# Help topic "People, passwords and pictures": tip 3, shown in a box of its own.
