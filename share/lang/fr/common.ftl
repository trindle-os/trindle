common-firewall-own-protocol = Utilisez tcp ou udp.

# Said when a port you open by hand isn't a number from 1 to 65535.
common-firewall-own-port = Ce n'est pas un port de 1 à 65535.

# Joins the last port to the others in a list of ports. { $first } is the others, comma separated.
common-firewall-and = { $first } et { $last }

# Heads a list of ports. { $count } is how many, { $list } is the ports, such as TCP 24810 and UDP 24811.
common-firewall-ports =
    { $count ->
        [one] Port { $list }
       *[other] Ports { $list }
    }

# Why a plugin's ports are refused. { $max } is the most it may name.
common-firewall-too-many = Un module peut nommer { $max } ports au maximum.

# Why a plugin's ports are refused. { $port } is a port such as TCP 24810.
common-firewall-twice = { $port } est nommé deux fois.

# Why a plugin's ports are refused. { $port } is a port such as TCP 80, { $lowest } the lowest allowed.
common-firewall-too-low = { $port } est inférieur à { $lowest }. Ces ports sont réservés au système.

# Why a plugin's port is refused. { $port } is the number.
common-firewall-reserved = Le port { $port } est utilisé par Trindle ou par un service courant, un module ne peut donc pas le demander.

# Why a plugin's port can't be opened. { $port } is such as TCP 24810, { $plugin } is the other plugin's name.
common-firewall-taken = { $port } est déjà utilisé par { $plugin }, il ne peut donc pas être ouvert aussi pour ce module.

# Why a plugin cannot open another port: { $max } is how many may be open.
common-firewall-full = Le nombre maximal de ports pouvant être ouverts pour les modules, { $max }, est déjà atteint.

