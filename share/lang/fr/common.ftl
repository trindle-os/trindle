# Red words when a step behind the administrator's password failed and said nothing of why.
# SAFETY: needs a human review before it ships
common-refused-no-reason = Cela n'a pas été fait. Une erreur s'est produite, sans raison indiquée.

# Red words when the keyring will not open without the person's password.
# SAFETY: needs a human review before it ships
common-keyring-locked = Le trousseau de clés est verrouillé. Fermez la session puis rouvrez-la, ou déverrouillez-le, puis réessayez.

# Red words when this computer has no keyring to keep a login or key in.
# SAFETY: needs a human review before it ships
common-keyring-missing = Il n'y a pas de trousseau de clés sur cet ordinateur pour l'enregistrer.

# Red words when the keyring is there and gives no answer in time.
# SAFETY: needs a human review before it ships
common-keyring-silent = Le trousseau de clés n'a pas répondu à temps.

# Red words when work with the keyring never ended, long after its deadline.
# SAFETY: needs a human review before it ships
common-keyring-never = Le trousseau de clés n'a jamais répondu.

# Red words when the turn with the keyring could not be taken. { $why } is the system's reason.
# SAFETY: needs a human review before it ships
common-keyring-turn-failed = Trindle n'a pas pu accéder au trousseau de clés ({ $why }), il ne l'a donc pas utilisé.

# Line shown while the keyring has not answered whether it kept or removed a login or key. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
# SAFETY: needs a human review before it ships
common-keyring-waiting =
    { $action ->
        [removing] Le trousseau de clés n'a pas encore répondu, donc l'élément ({ $what }) n'a pas encore été supprimé. S'il le supprime finalement, ce message l'indiquera.
       *[other] Le trousseau de clés n'a pas encore répondu, donc l'élément ({ $what }) n'a pas encore été enregistré. S'il l'enregistre finalement, ce message l'indiquera.
    }

# Line shown when the keyring answered late and did what was asked. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
# SAFETY: needs a human review before it ships
common-keyring-late-done =
    { $action ->
        [removing] Le trousseau de clés a répondu en retard, et l'élément ({ $what }) a été supprimé.
       *[other] Le trousseau de clés a répondu en retard, et l'élément ({ $what }) a été enregistré.
    }

# Red words when the keyring never answered. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
# SAFETY: needs a human review before it ships
common-keyring-late-never =
    { $action ->
        [removing] Le trousseau de clés n'a jamais répondu, donc l'élément ({ $what }) n'a pas été supprimé.
       *[other] Le trousseau de clés n'a jamais répondu, donc l'élément ({ $what }) n'a pas été enregistré.
    }

# Red words when the keyring answered late and would not do it. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping"; { $why } is the reason, as a sentence.
# SAFETY: needs a human review before it ships
common-keyring-late-refused =
    { $action ->
        [removing] Le trousseau de clés a répondu en retard et n'a pas supprimé l'élément ({ $what }) : { $why }
       *[other] Le trousseau de clés a répondu en retard et n'a pas enregistré l'élément ({ $what }) : { $why }
    }

