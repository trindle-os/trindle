
# machine translated (Spanish), not yet reviewed by a person.

# Name of the Settings page about the wallpaper, in the list and as its heading.
settings-wallpaper-title = Fondo de pantalla

# Words a person might type into the Settings search to find the wallpaper page; separate them with spaces.
settings-wallpaper-keywords = fondo imagen presentación foto wallpaper

# Introduction under the heading of the wallpaper page, and the words behind the page i.
settings-wallpaper-help = Usa un color liso, una imagen o una carpeta de imágenes que cambian con la frecuencia que elijas.

# Choice in the list of how long each picture stays.
settings-wallpaper-every-10s = 10 segundos

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30s = 30 segundos

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1m = 1 minuto

# Choice in the list of how long each picture stays.
settings-wallpaper-every-5m = 5 minutos

# Choice in the list of how long each picture stays.
settings-wallpaper-every-15m = 15 minutos

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30m = 30 minutos

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1h = 1 hora

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1d = 1 día

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fill = Llenar la pantalla

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fit = Ajustar la imagen completa

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-center = Centrar, tamaño real

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-stretch = Estirar

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-tile = Mosaico

# Choice in the list of the order pictures change in: at random.
settings-wallpaper-order-shuffle = Al azar

# Choice in the list of the order pictures change in: by file name.
settings-wallpaper-order-name = Por nombre de archivo

# Red words when the program that draws the wallpaper would not start.
settings-wallpaper-no-changer = Trindle no pudo iniciar el programa que cambia el fondo.

# Under the large picture, when counting; { $used } of { $all } pictures are used.
settings-wallpaper-count =
    { $all ->
        [one] { $used } de { $all } imagen
       *[other] { $used } de { $all } imágenes
    }

# Under the large picture; { $folder } is a folder with no pictures in it.
settings-wallpaper-empty-folder = { $folder } no tiene imágenes

# Under the large picture, for the pictures that come with Trindle; { $used } of { $all } are used.
settings-wallpaper-count-own =
    { $all ->
        [one] { $used } de { $all } imagen que viene con Trindle
       *[other] { $used } de { $all } imágenes que vienen con Trindle
    }

# Under the large picture, for a folder; { $used } of { $all } pictures are used and { $folder } is the folder.
settings-wallpaper-count-folder =
    { $all ->
        [one] { $used } de { $all } imagen de { $folder }
       *[other] { $used } de { $all } imágenes de { $folder }
    }

# Under the large picture, for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own = { $name }, una de las imágenes que vienen con Trindle

# Under the large picture when there is only a colour.
settings-wallpaper-plain-below = Un color liso, definido abajo.

# Under the large picture when the picture or folder has gone.
settings-wallpaper-gone-below = La imagen o la carpeta ya no está ahí. Elige otra.

# Sentence about the wallpaper when it is a plain colour.
settings-wallpaper-plain = Solo un color liso.

# Sentence about the wallpaper when Trindle's own pictures change; { $every } is how often, { $used } of { $all } pictures are used and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-own =
    { $all ->
        [one] Una imagen nueva cada { $every }, usando { $used } de la { $all } imagen que viene con Trindle.{ $extra }
       *[other] Una imagen nueva cada { $every }, usando { $used } de las { $all } imágenes que vienen con Trindle.{ $extra }
    }

# Sentence about the wallpaper when a folder's pictures change; { $every } is how often, { $used } of { $all } pictures are used, { $folder } is the folder's name and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-folder =
    { $all ->
        [one] Una imagen nueva cada { $every }, usando { $used } de la { $all } imagen de { $folder }.{ $extra }
       *[other] Una imagen nueva cada { $every }, usando { $used } de las { $all } imágenes de { $folder }.{ $extra }
    }

# Sentence about the wallpaper when its folder has no pictures; { $folder } is the folder.
settings-wallpaper-empty-folder-choose = La carpeta { $folder } no tiene imágenes. Elige otra.

# Added to the sentence about the wallpaper when a folder holds more than Trindle looks through.
settings-wallpaper-more-than-looked-at = La carpeta tiene más imágenes de las que Trindle puede revisar, así que algunas pueden quedar fuera.

# Sentence about the wallpaper for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own-said = { $name }, una de las imágenes que vienen con Trindle.

# Sentence about the wallpaper for one chosen picture; { $name } is its name, written to read in the middle of a sentence.
settings-wallpaper-file-one = Siempre se muestra { $name }.

# Sentence about the wallpaper when the chosen picture cannot be used; { $why } is the reason.
settings-wallpaper-file-refused = Trindle no usa esa imagen. { $why } Se muestra la propia imagen de Trindle en su lugar.

# Sentence about the wallpaper when the picture has gone.
settings-wallpaper-file-gone = La imagen ya no está. Elige una imagen o una carpeta.

# Said in green under a line after its choice was kept.
settings-wallpaper-saved = Guardado

# Said in green under the next picture line after the picture changed.
settings-wallpaper-changed = Cambiada

# Small word drawn in the corner of a moving picture's tile.
settings-wallpaper-animated = Animada

# Title of the window for choosing a picture.
settings-wallpaper-chooser-title = Elegir una imagen

# Name of the filter in that window that shows only pictures.
settings-wallpaper-chooser-filter = Imágenes

# Title of the window for choosing a folder of pictures.
settings-wallpaper-chooser-folder = Elegir una carpeta de imágenes

# Spoken description of the large picture when the wallpaper is a plain colour.
settings-wallpaper-plain-name = Un color liso

# Name of the large picture of what is on the screen.
settings-wallpaper-on-screen = En la pantalla

# Title of the Wallpaper card.
settings-wallpaper-card-title = Fondo de pantalla

# Heading of the wallpaper line, and name of its switch.
settings-wallpaper-wallpaper = Fondo de pantalla

# Heading of the line for choosing where the picture comes from.
settings-wallpaper-picture = Imagen

# Name of the round button that chooses one picture.
settings-wallpaper-choose-picture-button = Elegir una imagen

# Name of the round button that chooses a folder of pictures.
settings-wallpaper-choose-folder = Elegir una carpeta

# Name of the round button that chooses Trindle's own pictures.
settings-wallpaper-own-pictures = Imágenes propias de Trindle

# Heading of the fit line.
settings-wallpaper-fit = Ajuste

# Name of the list of how the picture fits the screen.
settings-wallpaper-fit-name = Cómo se adapta a la pantalla

# Heading of the colour line.
settings-wallpaper-colour = Color

# Small words under the colour line when a picture covers it.
settings-wallpaper-colour-hidden = Oculto por la imagen.

# Placeholder and name of the box for typing the colour as a hex code; the example is a code.
settings-wallpaper-colour-hex = Un código hexadecimal, por ejemplo #09090b

# Words behind the i of the Wallpaper card.
settings-wallpaper-card-about = Usa un color liso, una imagen o una carpeta de imágenes que cambian con la frecuencia que elijas. El color se ve solo cuando no hay imagen, y alrededor de una imagen que no cubre la pantalla. Escríbelo como código hexadecimal, por ejemplo #09090b.

# Small words on the cards that are greyed while the wallpaper is off.
settings-wallpaper-waits = Activa el fondo de pantalla para usar esto.

# Heading of the line, and name of its switch, for changing the picture now and then.
settings-wallpaper-rotate = Cambiar la imagen de vez en cuando

# Heading of the line, and name of its list, for how long each picture stays.
settings-wallpaper-every = Cambiar cada

# Heading of the line, and name of its list, for the order pictures change in.
settings-wallpaper-order = Orden

# Heading of the line, and name of its button, for moving to the next picture.
settings-wallpaper-next = Siguiente imagen

# Title of the Changing pictures card.
settings-wallpaper-changing-title = Imágenes cambiantes

# Words behind the i of that card.
settings-wallpaper-changing-about = Muestra todas las imágenes de una carpeta, una tras otra, con la frecuencia que elijas aquí, al azar o por nombre de archivo.

# Words behind the i of the Pictures card when pictures change by themselves.
settings-wallpaper-pictures-rotating = Trindle usa todas las imágenes que no están atenuadas. Pulsa una imagen para omitirla y púlsala otra vez para recuperarla. No se borra nada. La imagen grande es la que está ahora en pantalla.

# Words behind the i of the Pictures card when one picture is on.
settings-wallpaper-pictures-one = Pulsa una imagen para usarla.

# Title of the Pictures card.
settings-wallpaper-pictures-title = Imágenes

# Spoken description of the empty frame shown when there are no pictures.
settings-wallpaper-no-pictures-name = Aún no hay imágenes

# Heading of the line shown when there are no pictures to choose from.
settings-wallpaper-no-pictures = No hay imágenes para elegir
