# machine translated (Spanish), not yet reviewed by a person.

# The page shown before a Flatpak program is installed, with what it will be able to reach.
# Headline over the page; the source of the program is given.
store-fp-headline-from = ¿Instalar { $name } desde { $host }?

# Headline over the page for a program that has been downloaded.
store-fp-headline = ¿Instalar { $name }?

# Name of the card that lists what the program will be able to reach.
store-fp-card = A qué podrá acceder

# Tooltip of the round button that leaves without installing.
store-fp-cancel = No instalar

# The main button.
store-fp-install = Instalar

# Said while Flatpak is being asked what the program wants.
store-fp-reading = Leyendo lo que pide…

# Red words when what the program asks for could not be read.
store-fp-unread = Trindle no pudo leer lo que pide.

# Red words after Install was pressed once for a program whose list could not be read.
store-fp-unread-again = Pulsa Instalar otra vez para continuar.

# Said when the program is already on this computer; the name is given.
store-fp-have = { $name } ya está instalada.

# Said when the program asks to reach nothing outside its own box.
store-fp-none = Nada fuera de su propio espacio.

# Each line below is one thing the program will be able to reach.
store-fp-network = Internet y tu red local

store-fp-x11 = Las ventanas de otras aplicaciones y lo que escribes en ellas

store-fp-sound = El sonido y tu micrófono

store-fp-devices = Tu cámara y cualquier otro dispositivo conectado

store-fp-input = Mandos de juego y otros dispositivos de entrada

store-fp-kvm = Máquinas virtuales rápidas

store-fp-shm = Memoria compartida con otras aplicaciones

store-fp-usb = Dispositivos USB

store-fp-canbus = Dispositivos de bus CAN

store-fp-cups = Tus impresoras

store-fp-multiarch = Ejecutar programas de 32 bits

store-fp-escape = Ejecutar cualquier programa de este equipo

# A reference that also adds a second place to get apps from, named by its address.
store-fp-adds-source = Añadir { $host } a tus fuentes de aplicaciones

# Last line, when the program asks for more than the lines above say.
store-fp-other = Y otros ajustes

store-fp-bluetooth = Dispositivos Bluetooth

store-fp-smartcard = Tarjetas inteligentes

store-fp-ssh = Tus claves SSH

store-fp-gpg = Tus claves GPG

store-fp-devel = Herramientas de depuración, que le permiten vigilar y controlar los programas que inicia

store-fp-session-bus = Todos los programas que se ejecutan en tu sesión

store-fp-system-bus = Todos los servicios de este equipo

# A place the program can open and change; the place is given, as below.
store-fp-files = Abrir y cambiar { $what }

# The same for a place it can only look at.
store-fp-files-read = Ver { $what }

store-fp-where-host = todos los archivos de este equipo

store-fp-where-system = los archivos del sistema de este equipo

store-fp-where-home = toda tu carpeta personal, incluidos los archivos ocultos

store-fp-where-path = la carpeta { $path }

# A program on your session that it can talk to; the name is given.
store-fp-talk = Comunicarse con { $name }

# A service the program runs on your session.
store-fp-own = Ejecutar el servicio { $name }

store-fp-talk-system = Comunicarse con el servicio del sistema { $name }

store-fp-own-system = Ejecutar el servicio del sistema { $name }

# Said in red when Install failed and taking the program out again failed too.
store-fp-undo-failed = Puede que esté instalada a medias.

# Said in red when a bundle could not be copied for a safe read.
store-fp-copy-failed = No se pudo copiar el archivo para leerlo con seguridad.
