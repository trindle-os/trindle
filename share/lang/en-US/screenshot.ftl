# American English: only the lines that differ from English. The rest is English.

screenshot-eye-help = Press the eye dropper, then click anywhere on the screen to pick up the color under the pointer. Press Escape to cancel. Each color is copied as a hex code straight away and added to the list below, newest first, so you can copy it again later.

screenshot-eye-take = Pick a color

screenshot-eye-none = Pick a color from the screen.

screenshot-eye-taken =
    { $n ->
        [one] One color picked: { $newest }.
       *[other] { $n } colors picked. The newest is { $newest }.
    }

screenshot-eye-latest-empty = No color picked yet.

screenshot-eye-latest = Latest color

screenshot-eye-list = Your colors

screenshot-eye-list-empty = No colors picked yet.

screenshot-eye-damaged = Eye dropper colors

