common-in-use-microphone-off-note = आपने रिंग के माइक्रोफ़ोन बटन से इसे हर प्रोग्राम के लिए बंद किया है।

# Said where the person is working when a file of their own was damaged, was put aside beside itself and a new one begun. { $what } names what the file keeps, such as "Launch counts".
common-damaged-reset = { $what } रीसेट कर दिया गया, क्योंकि उसकी फ़ाइल ख़राब थी। ख़राब फ़ाइल को उसके बगल में रख लिया गया है।

# Said where the person is working when a file of their own is there but cannot be read, so nothing is saved into it and it is left as it is. { $what } names what the file keeps, such as "Launch counts".
common-unreadable-kept = { $what } सहेजा नहीं गया, क्योंकि Trindle उसकी फ़ाइल पढ़ नहीं सका। कुछ भी बदला नहीं गया है।

# What the file kept by the list of programs a box may use is called, in the words above.
common-unreadable-name-box-permissions = ऐप अनुमतियाँ

# What the file that notes which questions an app has already put to the person is called, in the words above.
common-unreadable-name-box-asked = पहले पूछे गए प्रश्न

# What the file that notes which apps came with the image is called, in the words above.
common-unreadable-name-box-offered = पहले लॉगिन पर सुझाए गए ऐप्स

# What the lists of a fenced program (its folders, hosts, settings and programs) are called, in the words above.
common-unreadable-name-fence = बाड़ सूचियाँ

# What the list of icons the desktop found missing is called, in the words above.
common-unreadable-name-missing-icons = गुम आइकनों की सूची

# What the screen arrangement an older version kept in display.sh is called, in the words above.
common-unreadable-name-old-display = स्क्रीन व्यवस्था

# Said where the person works when a known chip has no driver yet. The kernel is a version number.
common-no-driver-known-driver = { $chip } के लिए यहाँ अभी कोई ड्राइवर नहीं है। Linux { $kernel } पहला संस्करण है जिसमें उसका ड्राइवर आता है।

# Said when a known chip is missing a firmware file. The package and version name where it comes from.
common-no-driver-known-firmware = { $chip } का फ़र्मवेयर गुम है, जो { $package } { $version } में आता है।

# Said of a chip nothing is known about that has no driver. The class is Wi-Fi, Bluetooth, sound or graphics; the id is two hex numbers.
common-no-driver-generic = इस { $class } चिप ({ $id }) के लिए कोई ड्राइवर नहीं है।

# Said of a chip nothing is known about whose firmware file could not be loaded.
common-no-driver-generic-firmware = { $class } फ़र्मवेयर गुम है: { $file }।

# Added after a Wi-Fi line.
common-no-driver-stick = फ़िलहाल USB Wi-Fi स्टिक काम करती है।

# Tip of the small round i button that opens Help.
common-no-driver-more = इसके बारे में और जानें

common-no-driver-class-wifi = Wi-Fi

common-no-driver-class-bluetooth = Bluetooth

common-no-driver-class-sound = ध्वनि

common-no-driver-class-graphics = ग्राफ़िक्स

# The small round button beside a failure message that opens Help at the page
# about it. Its tip, and the name a screen reader says.
common-more = और

common-more-spoken = इसके बारे में और जानें, सहायता खोलता है

# Red words when an app's saved data was not deleted because its id is not a plain name.
common-removal-data-name = इसका डेटा नहीं मिटाया गया, क्योंकि ऐप के नाम में असामान्य अक्षर हैं।

# Red words when an app's saved data folder is a link or not a folder, so nothing was deleted.
common-removal-data-link = इसका डेटा नहीं मिटाया गया, क्योंकि इसका फ़ोल्डर कहीं और ले जाने वाला लिंक है।

# Red words when an app's saved data could not be deleted.
common-removal-data-failed = इसका डेटा नहीं मिटाया जा सका।


# First choice of "Ask for the password again after": the phone stays good for as long as it likes.
# SAFETY: needs a human review before it ships
common-pocketkey-never = कभी नहीं

# A choice of "Ask for the password again after", and the time in the screen's label: { $n } hours.
common-pocketkey-hours =
    { $n ->
        [one] 1 घंटा
       *[other] { $n } घंटे
    }

# A choice of "Ask for the password again after", and the time in the screen's label: { $n } days.
common-pocketkey-days =
    { $n ->
        [one] 1 दिन
       *[other] { $n } दिन
    }

# A choice of "Ask for the password again after", and the time in the screen's label: { $n } weeks.
common-pocketkey-weeks =
    { $n ->
        [one] 1 सप्ताह
       *[other] { $n } सप्ताह
    }

# On the lock and login screens, when the time chosen has passed and the phone is not accepted: { $time } is such as "1 hour".
# SAFETY: needs a human review before it ships
common-pocketkey-due = { $time } से ज़्यादा समय हो गया है, इसलिए आपको अपना पासवर्ड फिर से लिखना होगा।

# Said under the greyed Earlier versions card.
common-snap-no-snapper = पुराने संस्करणों के लिए snapper चाहिए, जो इस कंप्यूटर पर इंस्टॉल नहीं है।

# Said under the greyed Earlier versions card.
common-snap-from-snapshot = कंप्यूटर के स्नैपशॉट से शुरू होने पर यह नहीं हो सकता।

# Said under the greyed Earlier versions card.
common-snap-part-of-system = इस कंप्यूटर पर होम फ़ोल्डर सिस्टम का हिस्सा है, डिस्क का अपना अलग हिस्सा नहीं, इसलिए पुराने संस्करण सिस्टम से अलग नहीं रखे जा सकते।

# Said under the greyed Earlier versions card.
common-snap-network = होम फ़ोल्डर किसी दूसरे कंप्यूटर पर रखा है, इसलिए पुराने संस्करण यहाँ नहीं रखे जा सकते।

# Said under the greyed Earlier versions card: { $fs } is the kind of file system, such as ext4.
common-snap-not-btrfs = पुराने संस्करणों के लिए होम फ़ोल्डर Btrfs पर होना चाहिए, और यहाँ वह { $fs } पर है।

# Said under the greyed Earlier versions card.
common-snap-not-whole = आपका होम फ़ोल्डर डिस्क के किसी दूसरे हिस्से के अंदर है, अपने अलग हिस्से पर नहीं, इसलिए Trindle उसके पुराने संस्करण नहीं रख सकता।

# Said under the greyed Earlier versions card.
common-snap-read-only = होम फ़ोल्डर में अभी कुछ लिखा नहीं जा सकता, इसलिए कुछ भी नहीं रखा जा सकता।

# Said under the greyed Earlier versions card.
common-snap-locked-files = यहाँ होम फ़ोल्डर एक बंद फ़ाइल के रूप में रखा है, और उसकी रोज़ की एक प्रति डिस्क भर देगी।

# Said under the greyed Earlier versions card.
common-snap-elsewhere = आपका होम फ़ोल्डर /home के अंदर नहीं है, जहाँ प्रतियाँ ली जाती हैं।

# Said under the greyed Earlier versions card.
common-snap-apart = आपका होम फ़ोल्डर बंद है या दूसरों से अलग रखा है, इसलिए प्रतियों में वह शामिल नहीं हो सकता।

# Said under the greyed Earlier versions card.
common-snap-own-part = आपका होम फ़ोल्डर डिस्क का अपना अलग हिस्सा है, जिसे /home की प्रतियों में शामिल नहीं किया जाता।

# Why a plugin's port line in plugin.ini is refused. { $text } is what was written.
common-firewall-not-protocol-port = "{ $text }" protocol:port की तरह नहीं लिखा है, जैसे tcp:24810।

# Why a plugin's port line in plugin.ini is refused. { $text } is what was written before the colon.
common-firewall-bad-protocol = "{ $text }" tcp या udp नहीं है। इसे छोटे अक्षरों में लिखें।

# Why a plugin's port line in plugin.ini is refused. { $text } is what was written, { $lowest } the lowest port allowed.
common-firewall-bad-port = "{ $text }" { $lowest } से 65535 के बीच का पोर्ट नहीं है।

# Said when a port you open by hand isn't written as protocol:port.
common-firewall-own-form = इसे protocol:port की तरह लिखें, जैसे tcp:37666।

# Said when a port you open by hand starts with something other than tcp or udp.
common-firewall-own-protocol = tcp या udp लिखें।

# Said when a port you open by hand isn't a number from 1 to 65535.
common-firewall-own-port = यह 1 से 65535 के बीच का पोर्ट नहीं है।

# Joins the last port to the others in a list of ports. { $first } is the others, comma separated.
common-firewall-and = { $first } और { $last }

# Heads a list of ports. { $count } is how many, { $list } is the ports, such as TCP 24810 and UDP 24811.
common-firewall-ports =
    { $count ->
        [one] पोर्ट { $list }
       *[other] पोर्ट { $list }
    }

# Why a plugin's ports are refused. { $max } is the most it may name.
common-firewall-too-many = एक प्लगइन ज़्यादा से ज़्यादा { $max } पोर्ट बता सकता है।

# Why a plugin's ports are refused. { $port } is a port such as TCP 24810.
common-firewall-twice = { $port } दो बार लिखा है।

# Why a plugin's ports are refused. { $port } is a port such as TCP 80, { $lowest } the lowest allowed.
common-firewall-too-low = { $port } { $lowest } से नीचे है। वे पोर्ट सिस्टम के लिए रखे गए हैं।

# Why a plugin's port is refused. { $port } is the number.
common-firewall-reserved = पोर्ट { $port } Trindle या किसी आम सेवा के इस्तेमाल में है, इसलिए प्लगइन इसे नहीं माँग सकता।

# Why a plugin's port can't be opened. { $port } is such as TCP 24810, { $plugin } is the other plugin's name.
common-firewall-taken = { $port } को { $plugin } पहले से इस्तेमाल कर रहा है, इसलिए इसे इस प्लगइन के लिए भी नहीं खोला जा सकता।

# Why a plugin cannot open another port: { $max } is how many may be open.
common-firewall-full = प्लगइनों के लिए जितने पोर्ट खुल सकते हैं, यानी { $max }, वे पहले से खुले हैं।

# Told by a notice when the ring has been started again.
common-ring-held-back = रिंग लगातार कई बार बंद हुई, इसलिए Trindle ने उसे कुछ देर के लिए रोक दिया। अब वह फिर से चल रही है।

# Told by a notice when the ring has been started again.
common-ring-not-started = रिंग कुछ देर शुरू नहीं हो सकी। अब वह फिर से चल रही है।

# Told by a notice when the ring has been started again.
common-ring-not-ended = रिंग ने जवाब देना बंद कर दिया और कुछ देर बंद नहीं हो सकी। अब वह फिर से चल रही है।

# Told by a notice.
common-ring-not-done = कंप्यूटर से सस्पेंड, रीस्टार्ट या बंद होने को कहा गया, पर उसने ऐसा नहीं किया।

# Told by a notice; the ring is what the round menu is called.
common-ring-by-name = डेस्कटॉप इस रिंग को खुद शुरू नहीं कर सका, इसलिए वह पूरी स्क्रीन की विंडो के ऊपर नहीं खुल सकती और उसकी सूचनाएँ सबसे ऊपर नहीं रखी जातीं। लॉग आउट करके फिर लॉग इन करने से यह ठीक हो सकता है।

# A group of apps in the ring.
common-category-internet = इंटरनेट

# A group of apps in the ring (as above).
common-category-office = ऑफ़िस

# A group of apps in the ring (as above).
common-category-graphics = ग्राफ़िक्स

# A group of apps in the ring (as above).
common-category-media = ध्वनि और वीडियो

# A group of apps in the ring (as above).
common-category-games = खेल

# A group of apps in the ring (as above).
common-category-development = डेवलपमेंट

# A group of apps in the ring (as above).
common-category-learning = सीखना

# A group of apps in the ring (as above).
common-category-utilities = उपयोगी औज़ार

# A group of apps in the ring (as above).
common-category-system = सिस्टम

# Why an app cannot be started: its launcher names nothing to run.
common-app-no-command = इसमें चलाने के लिए कोई कमांड नहीं है।

# Why a launcher was left alone: { $why } is the reason.
common-launcher-unchanged = कुछ नहीं बदला गया, क्योंकि { $why }।

# The ring's notice when something is plugged in.
common-drive-arrived-usb = USB ड्राइव जुड़ी

# The ring's notice when something is plugged in (as above).
common-drive-arrived-card = मेमोरी कार्ड जुड़ा

# The ring's notice when something is plugged in (as above).
common-drive-arrived-disc = डिस्क डाली गई

# The ring's notice when something is plugged in (as above).
common-drive-arrived-other = ड्राइव जुड़ी

# Said in the password box after what the password is for.
common-drive-every-time = ड्राइव बदलने पर हर बार आपसे पूछा जाएगा। इस बॉक्स को बंद करने से कुछ नहीं बदलता।

# Said in the password box: { $rest } is what is being done, such as "format this drive".
common-drive-password-needed-to = { $rest } के लिए एडमिनिस्ट्रेटर का पासवर्ड चाहिए

# Said in the password box when the action is not named.
common-drive-password-needed = इस ड्राइव को बदलने के लिए एडमिनिस्ट्रेटर का पासवर्ड चाहिए

# Why a folder cannot be shared.
common-share-not-yours = सिर्फ़ वही फ़ोल्डर साझा किए जा सकते हैं जो आपके हैं।

# Why a share cannot have the name asked for.
common-share-name-is-login = यह नाम इस कंप्यूटर पर किसी का लॉगिन है, इसलिए साझा फ़ोल्डर का यह नाम नहीं हो सकता। कोई और नाम चुनें।

# Why a share cannot have the name asked for.
common-share-bad-name = साझा फ़ोल्डर के नाम में % < > * ? | / \ + = ; : " या अल्पविराम नहीं हो सकता।

# Why a folder cannot be shared.
common-share-no-guests = इस कंप्यूटर की Samba सेटिंग बिना पासवर्ड के साझा करने की अनुमति नहीं देतीं।

# Why a folder cannot be shared.
common-share-most = यह कंप्यूटर पहले ही उतने फ़ोल्डर साझा कर रहा है जितने की अनुमति है।

# Why a folder cannot be shared.
common-share-gone = वह फ़ोल्डर अब वहाँ नहीं है।

# Why a folder cannot be shared, when the program said nothing.
common-share-no-reason = Samba ने वजह नहीं बताई।

# Why a folder cannot be shared: { $said } is what the sharing program said.
common-share-said = Samba ने कहा: { $said }

# Why a screenshot could not be taken.
common-shot-no-desktop = फ़ोटो लेने के लिए कोई डेस्कटॉप नहीं है।

# Why a screenshot could not be taken.
common-shot-no-display = फ़ोटो लेने के लिए कोई डिस्प्ले नहीं है।

# Why a screenshot could not be taken.
common-shot-no-display-there = डेस्कटॉप के उस हिस्से में कोई स्क्रीन नहीं है।

# Why a screenshot could not be taken.
common-shot-cannot = इस डेस्कटॉप की फ़ोटो नहीं ली जा सकती।

# Why a screenshot could not be taken.
common-shot-too-big = स्क्रीनशॉट बहुत बड़ा है।

# Why a screenshot could not be taken.
common-shot-no-size = एक स्क्रीन ने खाली तस्वीर दी, इसलिए Trindle स्क्रीनशॉट नहीं ले सका।

# Why a screenshot could not be taken.
common-shot-unreadable = डेस्कटॉप ने ऐसी तस्वीर नहीं दी जिसे यह पढ़ सके।

# Why a screenshot could not be taken.
common-shot-no-memory = तस्वीर के लिए मेमोरी नहीं थी।

# Why a screenshot could not be taken.
common-shot-stopped = डेस्कटॉप ने स्क्रीन की फ़ोटो लेना बंद कर दिया।

# Why a screenshot could not be taken.
common-shot-failed = डेस्कटॉप स्क्रीन की फ़ोटो नहीं ले सका।

# Said where the person is working when no screen reader is installed.
common-reader-none-yet = कोई स्क्रीन रीडर इंस्टॉल नहीं है।

# Said wherever hiding a drive is offered or shown.
common-drive-not-a-lock = छिपाने से ड्राइव बंद या सुरक्षित नहीं होती। उसकी जुड़वाँ ड्राइव, जो अपने बारे में ठीक वही बताती है, उसके साथ छिप जाती है।

# Said when typed words are not a change to a key.
common-remap-not-a-key = यह ऐसी कुंजी नहीं है जिसे Trindle जानता हो। Escape, Ctrl+C या Left Click आज़माएँ।

# Said when typed words are not a change to a key.
common-remap-too-long = यह एक बदलाव में समाने से ज़्यादा कुंजियाँ हैं।

# Said when typed words are not a change to a key or a button.
common-no-equals = बदलाव में चाहिए: क्या दबाया जाता है, एक बराबर का चिह्न, और वह क्या बन जाता है।

# Said when typed words are not a change to a key.
common-remap-tapped-held = बताएँ कि हल्का दबाने पर क्या हो और दबाए रखने पर क्या, जैसे Escape हल्का दबाने पर, Ctrl दबाए रखने पर।

# Said when typed words are not a change to a controller button.
common-pads-not-a-button = यह ऐसा बटन नहीं है जिसे Trindle जानता हो। South, Left Trigger या Escape आज़माएँ।

# Said when typed words are not a change to a controller.
common-pads-not-a-zone = डेड ज़ोन 0% से 50% तक होता है।

# Said of a line in the controllers file that is not understood.
common-pads-not-a-heading = Trindle इस कंट्रोलर के शीर्षक को नहीं पहचानता।

# Said of a line in the controllers file that is not understood.
common-pads-no-heading = यह किसी कंट्रोलर के शीर्षक के नीचे नहीं है।

# What a theme's tile says when its file holds more than a theme may.
common-theme-too-big = यह फ़ाइल थीम होने के लिए बहुत बड़ी है, इसलिए इस्तेमाल नहीं की गई। थीम ज़्यादा से ज़्यादा 64 KB की हो सकती है।

