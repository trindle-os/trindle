# machine translated (Hindi), not yet reviewed by a person.

# The page shown before a Flatpak program is installed, with what it will be able to reach.
# Headline over the page; the source of the program is given.
store-fp-headline-from = { $host } से { $name } इंस्टॉल करें?

# Headline over the page for a program that has been downloaded.
store-fp-headline = { $name } इंस्टॉल करें?

# Name of the card that lists what the program will be able to reach.
store-fp-card = यह किन चीज़ों तक पहुँच सकेगा

# Tooltip of the round button that leaves without installing.
store-fp-cancel = इंस्टॉल न करें

# The main button.
store-fp-install = इंस्टॉल करें

# Said while Flatpak is being asked what the program wants.
store-fp-reading = पढ़ा जा रहा है कि यह क्या माँगता है…

# Red words when what the program asks for could not be read.
store-fp-unread = Trindle यह नहीं पढ़ सका कि यह क्या माँगता है।

# Red words after Install was pressed once for a program whose list could not be read.
store-fp-unread-again = आगे बढ़ने के लिए इंस्टॉल करें फिर से दबाएँ।

# Said when the program is already on this computer; the name is given.
store-fp-have = { $name } पहले से इंस्टॉल है।

# Said when the program asks to reach nothing outside its own box.
store-fp-none = अपने डिब्बे के बाहर कुछ नहीं।

# Each line below is one thing the program will be able to reach.
store-fp-network = इंटरनेट और आपका स्थानीय नेटवर्क

store-fp-x11 = दूसरे ऐप की विंडो, और उनमें आप जो टाइप करते हैं

store-fp-sound = आवाज़, और आपका माइक्रोफ़ोन

store-fp-devices = आपका कैमरा और जुड़ा हुआ हर दूसरा डिवाइस

store-fp-input = गेम कंट्रोलर और दूसरे इनपुट डिवाइस

store-fp-kvm = तेज़ वर्चुअल मशीनें

store-fp-shm = दूसरे ऐप के साथ साझा मेमोरी

store-fp-usb = USB डिवाइस

store-fp-canbus = CAN बस डिवाइस

store-fp-cups = आपके प्रिंटर

store-fp-multiarch = 32-बिट प्रोग्राम चलाना

store-fp-escape = इस कंप्यूटर पर कोई भी प्रोग्राम चलाना

# A reference that also adds a second place to get apps from, named by its address.
store-fp-adds-source = अपने ऐप स्रोतों में { $host } जोड़ें

# Last line, when the program asks for more than the lines above say.
store-fp-other = साथ में दूसरी सेटिंग

store-fp-bluetooth = Bluetooth डिवाइस

store-fp-smartcard = स्मार्ट कार्ड

store-fp-ssh = आपकी SSH कुंजियाँ

store-fp-gpg = आपकी GPG कुंजियाँ

store-fp-devel = डीबग करने के औज़ार, जिनसे यह अपने शुरू किए प्रोग्राम को देख और चला सकता है

store-fp-session-bus = आपके सत्र में चल रहा हर प्रोग्राम

store-fp-system-bus = इस कंप्यूटर की हर सेवा

# A place the program can open and change; the place is given, as below.
store-fp-files = { $what } खोलना और बदलना

# The same for a place it can only look at.
store-fp-files-read = { $what } देखना

store-fp-where-host = इस कंप्यूटर की हर फ़ाइल

store-fp-where-system = इस कंप्यूटर की सिस्टम फ़ाइलें

store-fp-where-home = आपका पूरा होम फ़ोल्डर, छिपी फ़ाइलों समेत

store-fp-where-path = फ़ोल्डर { $path }

# A program on your session that it can talk to; the name is given.
store-fp-talk = { $name } से बात करना

# A service the program runs on your session.
store-fp-own = सेवा { $name } चलाना

store-fp-talk-system = सिस्टम सेवा { $name } से बात करना

store-fp-own-system = सिस्टम सेवा { $name } चलाना

# Said in red when Install failed and taking the program out again failed too.
store-fp-undo-failed = हो सकता है यह आधा इंस्टॉल हो गया हो।

# Said in red when a bundle could not be copied for a safe read.
store-fp-copy-failed = सुरक्षित रूप से पढ़ने के लिए फ़ाइल कॉपी नहीं की जा सकी।
