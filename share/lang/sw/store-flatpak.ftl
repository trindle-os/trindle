# machine translated (Swahili), not yet reviewed by a person.

# The page shown before a Flatpak program is installed, with what it will be able to reach.
# Headline over the page; the source of the program is given.
store-fp-headline-from = Sakinisha { $name } kutoka { $host }?

# Headline over the page for a program that has been downloaded.
store-fp-headline = Sakinisha { $name }?

# Name of the card that lists what the program will be able to reach.
store-fp-card = Inachoweza kufikia

# Tooltip of the round button that leaves without installing.
store-fp-cancel = Usisakinishe

# The main button.
store-fp-install = Sakinisha

# Said while Flatpak is being asked what the program wants.
store-fp-reading = Inasoma inachoomba…

# Red words when what the program asks for could not be read.
store-fp-unread = Trindle haikuweza kusoma inachoomba.

# Red words after Install was pressed once for a program whose list could not be read.
store-fp-unread-again = Bonyeza Sakinisha tena ili kuendelea.

# Said when the program is already on this computer; the name is given.
store-fp-have = { $name } tayari imesakinishwa.

# Said when the program asks to reach nothing outside its own box.
store-fp-none = Hakuna chochote nje ya sanduku lake lenyewe.

# Each line below is one thing the program will be able to reach.
store-fp-network = Intaneti na mtandao wako wa karibu

store-fp-x11 = Madirisha ya programu nyingine, na unachoandika ndani yake

store-fp-sound = Sauti, na maikrofoni yako

store-fp-devices = Kamera yako na kila kifaa kingine kilichochomekwa

store-fp-input = Vidhibiti vya michezo na vifaa vingine vya kuingiza data

store-fp-kvm = Mashine pepe za kasi

store-fp-shm = Kumbukumbu inayoshirikiwa na programu nyingine

store-fp-usb = Vifaa vya USB

store-fp-canbus = Vifaa vya CAN bus

store-fp-cups = Printa zako

store-fp-multiarch = Kuendesha programu za biti 32

store-fp-escape = Kuendesha programu yoyote kwenye kompyuta hii

# A reference that also adds a second place to get apps from, named by its address.
store-fp-adds-source = Ongeza { $host } kwenye vyanzo vyako vya programu

# Last line, when the program asks for more than the lines above say.
store-fp-other = Pamoja na mipangilio mingine

store-fp-bluetooth = Vifaa vya Bluetooth

store-fp-smartcard = Kadi mahiri

store-fp-ssh = Funguo zako za SSH

store-fp-gpg = Funguo zako za GPG

store-fp-devel = Zana za kutafuta hitilafu, zinazoiruhusu kutazama na kudhibiti programu inazoanzisha

store-fp-session-bus = Kila programu inayoendeshwa kwenye kipindi chako

store-fp-system-bus = Kila huduma kwenye kompyuta hii

# A place the program can open and change; the place is given, as below.
store-fp-files = Fungua na ubadilishe { $what }

# The same for a place it can only look at.
store-fp-files-read = Tazama { $what }

store-fp-where-host = kila faili kwenye kompyuta hii

store-fp-where-system = faili za mfumo za kompyuta hii

store-fp-where-home = folda yako yote ya nyumbani, pamoja na faili zilizofichwa

store-fp-where-path = folda { $path }

# A program on your session that it can talk to; the name is given.
store-fp-talk = Ongea na { $name }

# A service the program runs on your session.
store-fp-own = Endesha huduma { $name }

store-fp-talk-system = Ongea na huduma ya mfumo { $name }

store-fp-own-system = Endesha huduma ya mfumo { $name }

# Said in red when Install failed and taking the program out again failed too.
store-fp-undo-failed = Huenda imesakinishwa kwa sehemu.

# Said in red when a bundle could not be copied for a safe read.
store-fp-copy-failed = Haikuweza kunakili faili ili kuisoma kwa usalama.
