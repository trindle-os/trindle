common-firewall-not-protocol-port = "{ $text }" haijaandikwa kama protocol:port, kama tcp:24810.

# Why a plugin's port line in plugin.ini is refused. { $text } is what was written before the colon.
common-firewall-bad-protocol = "{ $text }" si tcp wala udp. Iandike kwa herufi ndogo.

# Why a plugin's port line in plugin.ini is refused. { $text } is what was written, { $lowest } the lowest port allowed.
common-firewall-bad-port = "{ $text }" si lango kuanzia { $lowest } hadi 65535.

# Said when a port you open by hand isn't written as protocol:port.
common-firewall-own-form = Iandike kama protocol:port, kama tcp:37666.

# Said when a port you open by hand starts with something other than tcp or udp.
common-firewall-own-protocol = Tumia tcp au udp.

# Said when a port you open by hand isn't a number from 1 to 65535.
common-firewall-own-port = Hilo si lango kuanzia 1 hadi 65535.

# Joins the last port to the others in a list of ports. { $first } is the others, comma separated.
common-firewall-and = { $first } na { $last }

# Heads a list of ports. { $count } is how many, { $list } is the ports, such as TCP 24810 and UDP 24811.
common-firewall-ports =
    { $count ->
        [one] Lango { $list }
       *[other] Malango { $list }
    }

# Why a plugin's ports are refused. { $max } is the most it may name.
common-firewall-too-many = Programu jalizi inaweza kutaja malango { $max } kwa kiwango cha juu.

# Why a plugin's ports are refused. { $port } is a port such as TCP 24810.
common-firewall-twice = { $port } imetajwa mara mbili.

# Why a plugin's ports are refused. { $port } is a port such as TCP 80, { $lowest } the lowest allowed.
common-firewall-too-low = { $port } iko chini ya { $lowest }. Malango hayo yametengwa kwa ajili ya mfumo.

# Why a plugin's port is refused. { $port } is the number.
common-firewall-reserved = Lango { $port } linatumiwa na Trindle au huduma ya kawaida, kwa hiyo programu jalizi haiwezi kuliomba.

# Why a plugin's port can't be opened. { $port } is such as TCP 24810, { $plugin } is the other plugin's name.
common-firewall-taken = { $port } tayari inatumiwa na { $plugin }, kwa hiyo haiwezi kufunguliwa kwa programu jalizi hii pia.

# Why a plugin cannot open another port: { $max } is how many may be open.
common-firewall-full = Idadi ya juu ya malango yanayoweza kuwa wazi kwa programu jalizi, { $max }, tayari iko wazi.

