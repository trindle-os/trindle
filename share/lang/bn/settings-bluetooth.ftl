# machine translated (Bengali), not yet reviewed by a person.

# Said in red under the Bluetooth switch when switching it on failed for no known reason.
settings-bluetooth-on-failed = Bluetooth চালু করা যায়নি।

# Said in red under the Bluetooth switch when switching it off failed for no known reason.
settings-bluetooth-off-failed = Bluetooth বন্ধ করা যায়নি।

# Said in red when Bluetooth refuses something because it is not switched on; the first sentence says what could not be done.
settings-bluetooth-cause-not-ready = { $could_not } Bluetooth চালু নেই।

# Said in red when the PIN or number typed was wrong; the first sentence says what could not be done.
# SAFETY: needs a human review before it ships
settings-bluetooth-cause-auth-failed = { $could_not } PIN বা নম্বর গ্রহণ করা হয়নি। আবার চেষ্টা করুন।

# Said in red when the pairing was turned down; the first sentence says what could not be done.
# SAFETY: needs a human review before it ships
settings-bluetooth-cause-turned-down = { $could_not } পেয়ারিং এখানে বা অন্য ডিভাইসে প্রত্যাখ্যান করা হয়েছে।

# Said in red when the other device did not answer in time; the first sentence says what could not be done.
settings-bluetooth-cause-timeout = { $could_not } অন্য ডিভাইস সময়মতো সাড়া দেয়নি। সেটি পেয়ারিং মোডে রেখে আবার চেষ্টা করুন।

# Said in red when the same thing is already being done; the first sentence says what could not be done.
settings-bluetooth-cause-in-progress = { $could_not } Trindle এটি আগে থেকেই করছে। একটু অপেক্ষা করুন।

# Said in red when the device did not answer; the first sentence says what could not be done.
settings-bluetooth-cause-no-answer = { $could_not } ডিভাইস সাড়া দেয়নি। সেটি চালু ও কাছে আছে কিনা দেখে আবার চেষ্টা করুন।

# Said in red when the device is not ready to be used; the first sentence says what could not be done.
settings-bluetooth-cause-not-available = { $could_not } ডিভাইস ব্যবহারের জন্য তৈরি নয়। সেটি পেয়ারিং মোডে রেখে আবার চেষ্টা করুন।

# The word for the system bus in "The system bus is not available".
settings-bluetooth-the-bus = সিস্টেম বাস

# Headline of the page while Bluetooth is looked for.
settings-bluetooth-top-looking = Bluetooth পরীক্ষা করা হচ্ছে…

# Headline of the page when the Bluetooth service is not running.
settings-bluetooth-top-gone = এই কম্পিউটারে Bluetooth চলছে না।

# Headline of the page when Bluetooth is off.
settings-bluetooth-top-off = Bluetooth বন্ধ আছে।

# Headline of the page when Bluetooth is off at a switch or key on the computer itself.
settings-bluetooth-top-hard = Bluetooth কম্পিউটারের একটি সুইচ বা কী দিয়ে বন্ধ করা আছে।

# Headline of the page when the computer has no Bluetooth.
settings-bluetooth-top-none = এই কম্পিউটারে Bluetooth নেই।

# Headline of the page when the computer has an adapter that Bluetooth has not finished setting up.
settings-bluetooth-top-starting = Bluetooth চালু হচ্ছে…

# Headline of the page when the adapter was there a moment ago and has gone.
settings-bluetooth-top-lost = Bluetooth অ্যাডাপ্টারটি চলে গেছে।

# Headline of the page when Bluetooth is on and searching.
settings-bluetooth-top-searching = চালু আছে, ডিভাইস খোঁজা হচ্ছে…

# Headline of the page when Bluetooth is on and nothing is connected.
settings-bluetooth-top-idle = চালু আছে, কিন্তু কিছু সংযুক্ত নেই।

# Headline of the page when Bluetooth is on and devices are connected; the names are already joined into a list.
settings-bluetooth-top-connected =
    { $n ->
        [one] চালু আছে, এবং { $names } সংযুক্ত আছে।
       *[other] চালু আছে, এবং { $names } সংযুক্ত আছে।
    }

# Help text (i button) of the Bluetooth card.
settings-bluetooth-card-about = সুইচের নিচের নামটি আপনার Bluetooth অ্যাডাপ্টারের নাম। অন্য ডিভাইসের কাছে দৃশ্যমান চালু থাকলে কাছের ডিভাইস এই কম্পিউটারকে খুঁজে পাবে।

# Heading of the Bluetooth card, of its switch's line, and the name of its switch.
settings-bluetooth-title = Bluetooth

# Heading of the line with the switch that makes this computer visible, and the name of that switch.
settings-bluetooth-visible = অন্য ডিভাইসের কাছে দৃশ্যমান

# Heading of the card when Bluetooth is off at a switch on the computer itself.
settings-bluetooth-hard-line = কম্পিউটারেই বন্ধ করা আছে

# Small line under it.
settings-bluetooth-hard-line-sub = কম্পিউটারের নিজের সুইচ বা কী দিয়ে এটি চালু করুন।

# Heading of the card when the computer has no Bluetooth adapter.
settings-bluetooth-no-adapter = Bluetooth অ্যাডাপ্টার নেই

# Help text (i button) of that card.
settings-bluetooth-no-adapter-about = Trindle এই কম্পিউটারে কোনো Bluetooth অ্যাডাপ্টার খুঁজে পায়নি। USB সকেটে একটি লাগালে সঙ্গে সঙ্গে এখানে দেখা যাবে।

# Line in that card.
settings-bluetooth-none-found = কিছু পাওয়া যায়নি

# Line in the no-adapter card while Bluetooth finishes setting up the adapter.
settings-bluetooth-starting = চালু হচ্ছে

# Line in the no-adapter card when the adapter was there a moment ago.
settings-bluetooth-lost = অ্যাডাপ্টারটি চলে গেছে

# Small line under it.
settings-bluetooth-lost-sub = Trindle খুঁজতে থাকে এবং ফিরে এলে এখানে দেখায়। না এলে কম্পিউটার রিস্টার্ট করুন।

# Shown beside the Bluetooth switch while the password is asked for.
# SAFETY: needs a human review before it ships
settings-bluetooth-waiting = আপনার পাসওয়ার্ডের জন্য অপেক্ষা করা হচ্ছে…

# Said in red when this computer could not be made visible to other devices.
settings-bluetooth-visible-failed = Trindle এই কম্পিউটারকে অন্য ডিভাইসের কাছে দৃশ্যমান করতে পারেনি।

# Said in red when this computer could not be hidden from other devices.
settings-bluetooth-hidden-failed = Trindle এই কম্পিউটারকে অন্য ডিভাইসের কাছ থেকে লুকাতে পারেনি।

# Shown on the two device lists while Bluetooth is off.
settings-bluetooth-switch-on-first = এগুলো ব্যবহার করতে Bluetooth চালু করুন।

# Line in the My devices card when nothing is paired.
settings-bluetooth-none-paired = এখনও কিছু পেয়ার করা নেই

# Heading of the card that lists paired devices.
settings-bluetooth-mine = আমার ডিভাইস

# Help text (i button) of the My devices card.
settings-bluetooth-mine-about = এই কম্পিউটারের সঙ্গে পেয়ার করা ডিভাইস, যেখানে পড়া যায় সেখানে ব্যাটারির মাত্রাসহ। পাতা খোলার সময় যেগুলো সংযুক্ত ছিল সেগুলো আগে আসে, আর পাতা খোলা থাকলে ক্রম একই থাকে। কোনো ডিভাইস ভুলিয়ে দিলে আবার পেয়ার করতে হবে।

# Line in the Nearby card while the search runs.
settings-bluetooth-looking = ডিভাইস খোঁজা হচ্ছে…

# Tip of the button that stops the search.
settings-bluetooth-stop-looking = খোঁজা বন্ধ করুন

# Heading of the line that starts the search, and tip of its button.
settings-bluetooth-look = ডিভাইস খুঁজুন

# Heading of the card that lists devices nearby.
settings-bluetooth-nearby = কাছাকাছি

# Help text (i button) of the Nearby card.
settings-bluetooth-nearby-about = ডিভাইস খুঁজুন চাপুন, অন্য ডিভাইসটিকে পেয়ারিং মোডে রাখুন, তারপর তার পাশের পেয়ার করুন চাপুন। পাতা খোলার সময় কাছের ডিভাইস শক্তিশালী সংকেত অনুযায়ী সাজানো থাকে, আর নতুন পাওয়া ডিভাইস শেষে যোগ হয়। কোনোটি এখানকার নম্বরের সঙ্গে মেলানোর জন্য একটি নম্বর দেখায়, কোনোটি PIN চায়, যা প্রায়ই তার নির্দেশিকায় থাকে, অথবা 0000।

# Said in red when the search could not be stopped.
settings-bluetooth-stop-failed = Trindle ডিভাইস খোঁজা বন্ধ করতে পারেনি।

# Said in red when the search could not be started.
settings-bluetooth-start-failed = ডিভাইস খোঁজা শুরু করা যায়নি।

# Small line of a device that is connected.
settings-bluetooth-connected = সংযুক্ত

# Small line of a paired device that is not connected.
settings-bluetooth-not-connected = সংযুক্ত নয়

# Part of a device's small line: its battery level in per cent.
settings-bluetooth-battery = ব্যাটারি { $n }%

# Tip of the button that pairs a device, and the button of the same name in the pairing question.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair = পেয়ার করুন

# Tip of the button that disconnects a device.
settings-bluetooth-disconnect = বিচ্ছিন্ন করুন

# Tip of the button that connects a device.
settings-bluetooth-connect = সংযুক্ত করুন

# Tip of the bin button that forgets a device.
# SAFETY: needs a human review before it ships
settings-bluetooth-forget = এই ডিভাইস ভুলে যান

# Said in red when a device could not be disconnected.
settings-bluetooth-disconnect-failed = এটি বিচ্ছিন্ন করা যায়নি।

# Said in red when a device could not be forgotten.
settings-bluetooth-forget-failed = এটি ভুলিয়ে দেওয়া যায়নি।

# Shown under a device while it is being paired.
settings-bluetooth-pairing = পেয়ার হচ্ছে…

# Said in red when a device could not be paired.
settings-bluetooth-pair-failed = এটি পেয়ার করা যায়নি।

# Shown under a device while it is being connected.
settings-bluetooth-connecting = সংযুক্ত হচ্ছে…

# Said in red when a device could not be connected.
settings-bluetooth-connect-failed = এটি সংযুক্ত করা যায়নি।

# Said under a device that paired but could not be set to connect by itself.
settings-bluetooth-not-trusted = সংযুক্ত হয়েছে, কিন্তু Trindle পরেরবার নিজে থেকে সংযুক্ত হওয়ার মতো করতে পারেনি। ব্যবহার করতে চাইলে এখান থেকে সংযুক্ত করুন।

# Said under a device that shows a code to be typed on it; the code is already written.
settings-bluetooth-type-code = ডিভাইসে { $code } লিখুন, তারপর সেখানে Enter চাপুন।

# Question under a device that shows a number to compare with the one on this computer.
# SAFETY: needs a human review before it ships
settings-bluetooth-compare = অন্য ডিভাইসেও কি { $code } দেখাচ্ছে?

# Tip of the button that answers no to a pairing question.
# SAFETY: needs a human review before it ships
settings-bluetooth-no = না

# Tip of the button that says the numbers match.
# SAFETY: needs a human review before it ships
settings-bluetooth-yes-matches = হ্যাঁ, মিলেছে

# Question under a device that asks to be paired.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair-question = এই ডিভাইসের সঙ্গে পেয়ার করবেন?

# Placeholder of the box where a device's PIN is typed.
settings-bluetooth-pin = PIN

# Tip of the button that refuses to type a PIN.
# SAFETY: needs a human review before it ships
settings-bluetooth-cancel = বাতিল করুন

# Help line above the box where a device's PIN is typed.
# SAFETY: needs a human review before it ships
settings-bluetooth-pin-help = এই ডিভাইসের PIN লিখুন। এটি প্রায়ই নির্দেশিকায় থাকে। না থাকলে 0000 দিয়ে দেখুন।

# Words the settings search looks for on this page (not shown).
settings-bluetooth-keywords = হেডফোন মাউস কীবোর্ড পেয়ার ডিভাইস ওয়্যারলেস headphones mouse keyboard pair devices wireless

# Help text at the top of the page.
settings-bluetooth-help = ডিভাইস খুঁজুন চাপুন, অন্য ডিভাইসটিকে পেয়ারিং মোডে রাখুন, তারপর তার পাশের পেয়ার করুন চাপুন।

# Said in red under the Bluetooth switch when restarting the sound service after Bluetooth came back on failed; $why is the system's own reason.
settings-bluetooth-sound-failed = Trindle Bluetooth-এর শব্দ রিস্টার্ট করতে পারেনি, তাই আবার লগইন না করা পর্যন্ত হেডফোনে শব্দ স্বাভাবিকের চেয়ে খারাপ হতে পারে। { $why }

# Tooltip of the help button beside the Bluetooth switch.
settings-bluetooth-sound-help = Bluetooth বন্ধ করে আবার চালু করার পর হেডফোনের শব্দ কেন খারাপ হয়


# Said in red when a device is no longer in BlueZ's list; the first sentence says what could not be done.
settings-bluetooth-cause-gone = { $could_not } এই কম্পিউটারে ডিভাইসটি আর সংরক্ষিত নেই। আবার খুঁজে দেখুন।

# Said in red when a paired device's saved pairing is refused; the first sentence says what could not be done.
settings-bluetooth-cause-old-pairing = { $could_not } ডিভাইসটি আর সংরক্ষিত পেয়ারিং গ্রহণ করে না। ডিভাইসটি ভুলিয়ে দিয়ে আবার পেয়ার করুন।

# Said in red under a device that connected and then dropped at once.
settings-bluetooth-dropped = এটি সংযুক্ত হয়েছিল, তারপর সংযোগ হারিয়েছে। সংরক্ষিত পেয়ারিং পুরনো হয়ে থাকতে পারে।

# Tooltip of the button that forgets a paired device and looks for it afresh.
settings-bluetooth-pair-again = ভুলে গিয়ে আবার পেয়ার করুন

# Said under Look for devices after a device was forgotten to be paired afresh.
settings-bluetooth-forgotten-pair = ডিভাইসটি ভুলিয়ে দেওয়া হয়েছে। এটি পেয়ারিং মোডে রাখুন, তারপর নিচে দেখা গেলে পেয়ার করুন চাপুন।

# Tooltip of the button that opens Help from a failed connection.
settings-bluetooth-more = এ সম্পর্কে আরও জানুন
