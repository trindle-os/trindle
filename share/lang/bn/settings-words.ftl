
# machine translated (Bengali), not yet reviewed by a person.

# The card's heading.
settings-words-heading = আপনার নিজের শব্দ

# Under the heading.
settings-words-about = Trindle যে শব্দ দেখায় তা যেকোনো ভাষায় বদলান, আর আপনার বদলগুলো শেয়ার করুন।

# The first line of the card: what is locked, in plain words.
settings-words-rule = শুধু শেষ কলামটি বদলান। অন্য কিছু বদলালে, বা শিটটি Trindle-এর নিজের না হলে, Trindle সেটি নেবে না।

# The line that picks which language the boxes are for.
settings-words-language = ভাষা

# The name of the language list for the screen reader.
settings-words-language-tip = তালিকার ভাষা

# The line that exports the sheet, and its button's tip.
settings-words-export = শিট সংরক্ষণ করুন

# Under the export line.
settings-words-export-sub = বাঁয়ে ইংরেজি, পাশে আপনার ভাষা। ডান দিকটা বদলান।

# Title of the window that asks where to save the sheet.
settings-words-export-title = শব্দতালিকা সংরক্ষণ করুন

# The line that imports a sheet, and its button's tip.
settings-words-import = একটি শিট খুলুন

# Under the import line.
settings-words-import-sub = এতে কিছু ভুল থাকলে কিছুই ইনস্টল হয় না।

# Title of the window that asks which sheet to open.
settings-words-import-title = শব্দতালিকা খুলুন

# Under the import button when a sheet was installed.
settings-words-imported = ইনস্টল হয়েছে

# Under a box or the export button when the words could not be kept.
settings-words-not-saved = সংরক্ষণ করা যায়নি।

# Under the import button: the file is bigger than any sheet.
settings-words-too-big = ফাইলটি অনেক বড়।

# Under the import button: the file is not text.
settings-words-not-text = এটি সাধারণ লেখা নয়।

# Under the import button: the file holds control or hidden characters.
settings-words-not-plain = এতে লুকানো বা নিয়ন্ত্রণ অক্ষর আছে।

# Under the import button: a line is longer than any line of a sheet.
settings-words-line-long = একটি লাইন অনেক লম্বা।

# Under the import button: the file is not a Trindle word sheet.
settings-words-not-mine = এটি Trindle-এর শব্দতালিকা নয়।

# Under the import button: the sheet is of another version.
settings-words-version = এটি Trindle-এর অন্য একটি সংস্করণের জন্য।

# Under the import button: the language tag is not usable.
settings-words-bad-language = ভাষাটি সঠিক নয়।

# Under the import button: the notes at the top were changed.
settings-words-notes = তালিকার উপরের অংশ বদলানো হয়েছে।

# Under the import button: lines are missing or extra.
settings-words-count = কিছু লাইন কম বা বেশি আছে।

# Under the import button: a key is not the one Trindle has. The key is { $key }.
settings-words-key = { $key } কীটি বদলানো হয়েছে।

# Under the import button: an English line was changed. The key is { $key }.
settings-words-english = { $key }-এর ইংরেজি লেখা বদলানো হয়েছে।

# Under the import button: a row is not in the right form. The key is { $key }.
settings-words-shape = { $key }-এর সারি ঠিকভাবে সাজানো নেই।

# Under a box or the import button: the translation is too long. The key is { $key }.
settings-words-long = { $key }-এর শব্দ অনেক লম্বা।

# Under a box or the import button: the translation holds hidden or control characters. The key is { $key }.
settings-words-characters = { $key }-এর শব্দে লুকানো অক্ষর আছে।

# Under a box or the import button: the translation holds markup, a link or a path. The key is { $key }.
settings-words-links = { $key }-এর শব্দে ফরম্যাটিং, লিংক বা পাথ আছে।

# Under a box or the import button: the translation's placeholders differ from the English. The key is { $key }.
settings-words-placeholders = { $key }-এর প্লেসহোল্ডার ইংরেজির সঙ্গে মেলে না।

# Under the import button: the file cannot be read as a plain file.
settings-words-not-sheet = Trindle ফাইলটি পড়তে পারেনি।

# Added to the card's i: when changed words appear.
settings-words-next-start = সেটিংস আপনার শব্দ এখনই দেখায়, অন্য প্রোগ্রাম পরের বার চালু হলে।

# Under the import button: the check value does not match what Trindle wrote.
settings-words-check-value = যাচাইয়ের কোড মিলছে না।

settings-words-reset = Trindle-এর শব্দে ফিরুন

settings-words-reset-sub = Trindle-এর শব্দগুলো ফিরিয়ে আনে। আপনার শব্দ ব্যাকআপ হিসেবে রাখা হয়।

# The button that opens the page where a finished sheet is offered for the next version.
settings-words-offer = আপনার শিট শেয়ার করুন

# Under the offer button: who can send and why.
settings-words-offer-sub = একটি পাতা খোলে যেখান থেকে আপনি নিজে এটি পাঠাতে পারেন। Trindle কখনো এটি পাঠায় না।

# The line that starts a language of your own, and its button's tip.
settings-words-start = নিজের ভাষা শুরু করুন

# Under the start line.
settings-words-start-sub = যেকোনো নাম দিন। এটি ইংরেজির একটি কপি হিসেবে শুরু হয়।

# Inside the empty name box, and its name for the screen reader.
settings-words-name-tip = আপনার ভাষার নাম

# Beside the start line when the language was made.
settings-words-started = শুরু হয়েছে

# Under the start line: the name is empty or too long.
settings-words-name-length = ১ থেকে ৩০টি অক্ষর ব্যবহার করুন

# Under the start line: the name holds markup, a path or hidden characters.
settings-words-name-plain = শুধু অক্ষর ব্যবহার করুন, কোনো ফরম্যাটিং, পাথ বা লুকানো অক্ষর নয়।

# Under the start line: another language of your own has this name.
settings-words-name-taken = এই নামে আপনার একটি ভাষা আগে থেকেই আছে।

# A language of your own in the language lists. { $name } is the name the person gave it.
settings-words-own-label = { $name } (আপনার নিজের)

# Under the reset line for a language of your own: the button asks twice. Never taken from a sheet.
settings-words-reset-own-sub = আপনার ভাষাটি সরিয়ে দেয় এবং এর শব্দের একটি ব্যাকআপ রাখে।
