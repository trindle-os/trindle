# machine translated (Bengali), not yet reviewed by a person.

# The page shown before a Flatpak program is installed, with what it will be able to reach.
# Headline over the page; the source of the program is given.
store-fp-headline-from = { $host } থেকে { $name } ইনস্টল করবেন?

# Headline over the page for a program that has been downloaded.
store-fp-headline = { $name } ইনস্টল করবেন?

# Name of the card that lists what the program will be able to reach.
store-fp-card = এটি যা যা ছুঁতে পারবে

# Tooltip of the round button that leaves without installing.
store-fp-cancel = ইনস্টল করবেন না

# The main button.
store-fp-install = ইনস্টল করুন

# Said while Flatpak is being asked what the program wants.
store-fp-reading = এটি কী চায় তা পড়া হচ্ছে…

# Red words when what the program asks for could not be read.
store-fp-unread = এটি কী চায়, Trindle তা পড়তে পারেনি।

# Red words after Install was pressed once for a program whose list could not be read.
store-fp-unread-again = এগিয়ে যেতে আবার ইনস্টল করুন চাপুন।

# Said when the program is already on this computer; the name is given.
store-fp-have = { $name } আগে থেকেই ইনস্টল করা আছে।

# Said when the program asks to reach nothing outside its own box.
store-fp-none = নিজের গণ্ডির বাইরে কিছুই নয়।

# Each line below is one thing the program will be able to reach.
store-fp-network = ইন্টারনেট ও আপনার স্থানীয় নেটওয়ার্ক

store-fp-x11 = অন্য অ্যাপের জানালা, আর সেখানে আপনি যা টাইপ করেন

store-fp-sound = শব্দ ও আপনার মাইক্রোফোন

store-fp-devices = আপনার ক্যামেরা ও লাগানো অন্য সব ডিভাইস

store-fp-input = গেম কন্ট্রোলার ও অন্য ইনপুট ডিভাইস

store-fp-kvm = দ্রুত ভার্চুয়াল মেশিন

store-fp-shm = অন্য অ্যাপের সঙ্গে ভাগ করা মেমরি

store-fp-usb = USB ডিভাইস

store-fp-canbus = CAN বাস ডিভাইস

store-fp-cups = আপনার প্রিন্টার

store-fp-multiarch = ৩২-বিটের প্রোগ্রাম চালানো

store-fp-escape = এই কম্পিউটারে যেকোনো প্রোগ্রাম চালানো

# A reference that also adds a second place to get apps from, named by its address.
store-fp-adds-source = আপনার অ্যাপ সোর্সে { $host } যোগ করুন

# Last line, when the program asks for more than the lines above say.
store-fp-other = এবং আরও কিছু সেটিং

store-fp-bluetooth = ব্লুটুথ ডিভাইস

store-fp-smartcard = স্মার্ট কার্ড

store-fp-ssh = আপনার SSH কী

store-fp-gpg = আপনার GPG কী

store-fp-devel = ডিবাগ করার টুল, যা দিয়ে এটি নিজের চালানো প্রোগ্রাম দেখতে ও চালাতে পারে

store-fp-session-bus = আপনার সেশনে চলা প্রতিটি প্রোগ্রাম

store-fp-system-bus = এই কম্পিউটারের প্রতিটি সার্ভিস

# A place the program can open and change; the place is given, as below.
store-fp-files = { $what } খুলতে ও বদলাতে পারবে

# The same for a place it can only look at.
store-fp-files-read = { $what } দেখতে পারবে

store-fp-where-host = এই কম্পিউটারের প্রতিটি ফাইল

store-fp-where-system = এই কম্পিউটারের সিস্টেম ফাইল

store-fp-where-home = আপনার পুরো হোম ফোল্ডার, লুকানো ফাইলসহ

store-fp-where-path = { $path } ফোল্ডার

# A program on your session that it can talk to; the name is given.
store-fp-talk = { $name }-এর সঙ্গে কথা বলতে পারবে

# A service the program runs on your session.
store-fp-own = { $name } সার্ভিস চালাবে

store-fp-talk-system = সিস্টেম সার্ভিস { $name }-এর সঙ্গে কথা বলতে পারবে

store-fp-own-system = সিস্টেম সার্ভিস { $name } চালাবে

# Said in red when Install failed and taking the program out again failed too.
store-fp-undo-failed = এটি আংশিক ইনস্টল হয়ে থাকতে পারে।

# Said in red when a bundle could not be copied for a safe read.
store-fp-copy-failed = নিরাপদে পড়ার জন্য ফাইলটি কপি করা যায়নি।
