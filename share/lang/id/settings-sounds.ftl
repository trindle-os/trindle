# machine translated (Indonesian), not yet reviewed by a person.

# Name of the Settings page about event sounds, in the list and as its heading.
settings-sounds-title = Suara

# Words a person might type into the Settings search to find the sounds page; separate them with spaces.
settings-sounds-keywords = suara bunyi nada awal mulai login masuk logout keluar matikan pengisi daya dicolok dicabut baterai peringatan bip mati senyap sendiri kustom tambah file wav ogg mp3

# Introduction under the heading of the sounds page, and the words behind the page i.
settings-sounds-help = Pilih suara untuk setiap momen, misalnya saat masuk. Anda juga dapat menambahkan suara Anda sendiri.

# First choice in each moment's list of sounds: that moment makes no sound.
settings-sounds-off = Mati

# Sentence at the top of the page when no moment makes a sound.
settings-sounds-top-none = Semuanya senyap.

# Sentence at the top of the page when every moment makes a sound.
settings-sounds-top-all = Semua suara menyala.

# Sentence at the top of the page when some moments make a sound; { $n } is how many of the { $total } do.
settings-sounds-top-some = 
    { $n ->
       *[other] { $n } dari { $total } suara menyala. Sisanya mati.
    }

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-open = Trindle terbuka

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-close = Trindle tertutup

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-sunrise = Matahari terbit

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-sunset = Matahari terbenam

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-rising = Naik

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-falling = Turun

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-alert = Peringatan

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-bell = Lonceng

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-glass = Kaca

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-pop = Pop

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-login = Masuk

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-logout = Keluar, menyalakan ulang, dan mematikan

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-plug = Pengisi daya dicolok

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-unplug = Pengisi daya dicabut

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-battery = Baterai lemah

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-notification = Notifikasi muncul

# Heading of the logging out line.
settings-sounds-moment-logout-short = Keluar

# Heading of the notifications line.
settings-sounds-moment-notification-short = Notifikasi

# Small words under the logging out line.
settings-sounds-moment-logout-about = Juga saat memulai ulang dan mematikan.

# Heading and slider name for the volume of the logging in and out sounds.
settings-sounds-volume-coming = Volume masuk dan keluar

# Heading and slider name for the volume of notification sounds.
settings-sounds-volume-notifications = Volume notifikasi

# Heading and slider name for the volume of the charger and battery sounds.
settings-sounds-volume-power = Volume suara daya

# Name of the round button that plays the sound chosen for a moment, or an added sound.
settings-sounds-hear = Putar

# Name of the button that opens a window to add sound files.
settings-sounds-add = Tambah file suara

# Name of the button that opens the folder where added sounds are kept.
settings-sounds-open-folder = Buka folder untuk suara yang ditambahkan

# Red words under the add sounds line when the folder could not be opened.
settings-sounds-folder-not-opened = Folder tidak dapat dibuka.

# Red words under the add sounds line when the folder for added sounds could not be made.
settings-sounds-folder-not-made = Trindle tidak dapat membuat folder untuk suara Anda.

# Name of the button that plays the sound being added, when one of the same name is already there.
settings-sounds-hear-new = Putar suara baru

# Name of the button that plays the sound already there, when one of the same name is being added.
settings-sounds-hear-old = Putar suara yang sudah ada

# Heading of the line for adding sounds.
settings-sounds-add-heading = Tambah suara

# Name of the bin button that removes a sound added by the person.
# SAFETY: needs a human review before it ships
settings-sounds-remove = Hapus suara ini

# Heading of the line shown when no sounds have been added.
settings-sounds-none-yet = Belum ada yang ditambahkan

# Red words under a moment's line when its chosen sound file is gone.
settings-sounds-gone = Suara itu sudah tidak ada di komputer ini. Pilih yang lain.

# Red words under a line when a sound would not play.
settings-sounds-would-not-play = Suara tidak diputar. Periksa speaker Anda di Audio.

# Title of the window for choosing sound files.
settings-sounds-chooser-title = Pilih file suara

# Name of the filter in the window for choosing sound files that shows only sounds.
settings-sounds-chooser-filter = Suara

# Red words under the add sounds line when a chosen file is not a sound; { $name } is the file name.
settings-sounds-not-playable = Trindle tidak dapat memutar { $name } karena tidak mengenali jenis file-nya.

# Red words under the add sounds line when a file could not be copied in; { $name } is the file name.
settings-sounds-not-copied = { $name } tidak dapat disalin.

# Green words under the add sounds line after sounds were added; { $n } is how many.
settings-sounds-added =
    { $n ->
       *[other] { $n } suara ditambahkan. Sekarang Anda dapat memilihnya untuk momen mana pun di atas.
    }

# Red words under the question about a sound of the same name when it could not be replaced; { $name } is the file name.
settings-sounds-not-replaced = { $name } tidak dapat diganti.

# Green words after one sound took the place of the one there; { $name } is the file name.
settings-sounds-replaced-one = { $name } sudah diganti.

# Green words after several sounds took the place of the ones there; { $n } of { $total } were done.
settings-sounds-replaced-some = { $n } dari { $total } diganti.

# Red words under a sound's line when it could not be removed.
# SAFETY: needs a human review before it ships
settings-sounds-not-removed = Tidak dapat dihapus.

# Red words under a moment's line when its sound was removed and the moment could not be set back to its own sound.
settings-sounds-not-set-back = Trindle menghapus suara itu, tetapi tidak dapat mengembalikan suara bawaan untuk momen itu.

# Title of the card with the sounds for logging in and out and notifications.
settings-sounds-coming-title = Masuk dan keluar

# Words behind the i of that card.
settings-sounds-coming-about = Setiap volume berkisar dari 0 sampai 100 dalam kelipatan sepuluh. Anda mendengar suaranya sekali saat melepasnya.

# Title of the card with the charger and battery sounds.
settings-sounds-power-title = Daya

# Words behind the i of that card.
settings-sounds-power-about = Suara untuk mencolokkan dan mencabut pengisi daya, dan untuk baterai hampir habis. Volume berkisar dari 0 sampai 100 dalam kelipatan sepuluh. Anda mendengar suaranya sekali saat melepasnya.

# Title of the card with the sounds the person added.
settings-sounds-own-title = Suara Anda sendiri

# Words behind the i of that card.
# SAFETY: needs a human review before it ships
settings-sounds-own-about = WAV, OGG, Opus, FLAC, atau MP3. Trindle menyalinnya ke folder Anda sendiri, jadi Anda boleh memindahkan atau menghapus file aslinya. Setelah itu Anda dapat memilihnya untuk momen mana pun, seperti yang lain. Jika Anda menghapus satu suara, momen mana pun yang memakainya kembali ke suara bawaannya.
