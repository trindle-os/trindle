# machine translated (Indonesian), not yet reviewed by a person.

# The page shown before a Flatpak program is installed, with what it will be able to reach.
# Headline over the page; the source of the program is given.
store-fp-headline-from = Pasang { $name } dari { $host }?

# Headline over the page for a program that has been downloaded.
store-fp-headline = Pasang { $name }?

# Name of the card that lists what the program will be able to reach.
store-fp-card = Apa yang bisa diakses

# Tooltip of the round button that leaves without installing.
store-fp-cancel = Jangan pasang

# The main button.
store-fp-install = Pasang

# Said while Flatpak is being asked what the program wants.
store-fp-reading = Membaca apa yang diminta…

# Red words when what the program asks for could not be read.
store-fp-unread = Trindle tidak bisa membaca apa yang diminta.

# Red words after Install was pressed once for a program whose list could not be read.
store-fp-unread-again = Tekan Pasang lagi untuk melanjutkan.

# Said when the program is already on this computer; the name is given.
store-fp-have = { $name } sudah terpasang.

# Said when the program asks to reach nothing outside its own box.
store-fp-none = Tidak ada akses di luar kotaknya sendiri.

# Each line below is one thing the program will be able to reach.
store-fp-network = Internet dan jaringan lokal Anda

store-fp-x11 = Jendela aplikasi lain, dan apa yang Anda ketik di dalamnya

store-fp-sound = Suara, dan mikrofon Anda

store-fp-devices = Kamera Anda dan semua perangkat lain yang tercolok

store-fp-input = Pengontrol game dan perangkat input lainnya

store-fp-kvm = Mesin virtual yang cepat

store-fp-shm = Memori yang dibagi dengan aplikasi lain

store-fp-usb = Perangkat USB

store-fp-canbus = Perangkat CAN bus

store-fp-cups = Printer Anda

store-fp-multiarch = Menjalankan program 32-bit

store-fp-escape = Menjalankan program apa pun di komputer ini

# A reference that also adds a second place to get apps from, named by its address.
store-fp-adds-source = Tambahkan { $host } ke sumber aplikasi Anda

# Last line, when the program asks for more than the lines above say.
store-fp-other = Ditambah pengaturan lain

store-fp-bluetooth = Perangkat Bluetooth

store-fp-smartcard = Kartu pintar

store-fp-ssh = Kunci SSH Anda

store-fp-gpg = Kunci GPG Anda

store-fp-devel = Alat debugging, yang memungkinkannya mengawasi dan mengendalikan program yang dijalankannya

store-fp-session-bus = Semua program yang berjalan di sesi Anda

store-fp-system-bus = Semua layanan di komputer ini

# A place the program can open and change; the place is given, as below.
store-fp-files = Membuka dan mengubah { $what }

# The same for a place it can only look at.
store-fp-files-read = Melihat { $what }

store-fp-where-host = semua file di komputer ini

store-fp-where-system = file sistem komputer ini

store-fp-where-home = seluruh folder home Anda, termasuk file tersembunyi

store-fp-where-path = folder { $path }

# A program on your session that it can talk to; the name is given.
store-fp-talk = Berkomunikasi dengan { $name }

# A service the program runs on your session.
store-fp-own = Menjalankan layanan { $name }

store-fp-talk-system = Berkomunikasi dengan layanan sistem { $name }

store-fp-own-system = Menjalankan layanan sistem { $name }

# Said in red when Install failed and taking the program out again failed too.
store-fp-undo-failed = Mungkin terpasang sebagian.

# Said in red when a bundle could not be copied for a safe read.
store-fp-copy-failed = Tidak bisa menyalin file untuk dibaca dengan aman.
