# machine translated (Brazilian Portuguese), not yet reviewed by a person.

# The page shown before a Flatpak program is installed, with what it will be able to reach.
# Headline over the page; the source of the program is given.
store-fp-headline-from = Instalar { $name } de { $host }?

# Headline over the page for a program that has been downloaded.
store-fp-headline = Instalar { $name }?

# Name of the card that lists what the program will be able to reach.
store-fp-card = O que ele poderá acessar

# Tooltip of the round button that leaves without installing.
store-fp-cancel = Não instalar

# The main button.
store-fp-install = Instalar

# Said while Flatpak is being asked what the program wants.
store-fp-reading = Lendo o que ele pede…

# Red words when what the program asks for could not be read.
store-fp-unread = O Trindle não conseguiu ler o que ele pede.

# Red words after Install was pressed once for a program whose list could not be read.
store-fp-unread-again = Toque em Instalar de novo para continuar.

# Said when the program is already on this computer; the name is given.
store-fp-have = { $name } já está instalado.

# Said when the program asks to reach nothing outside its own box.
store-fp-none = Nada fora da sua própria caixa.

# Each line below is one thing the program will be able to reach.
store-fp-network = A internet e a sua rede local

store-fp-x11 = Janelas de outros aplicativos e o que você digita nelas

store-fp-sound = O som e o seu microfone

store-fp-devices = Sua câmera e todos os outros dispositivos conectados

store-fp-input = Controles de jogos e outros dispositivos de entrada

store-fp-kvm = Máquinas virtuais rápidas

store-fp-shm = Memória compartilhada com outros aplicativos

store-fp-usb = Dispositivos USB

store-fp-canbus = Dispositivos CAN bus

store-fp-cups = Suas impressoras

store-fp-multiarch = Executar programas de 32 bits

store-fp-escape = Executar qualquer programa neste computador

# A reference that also adds a second place to get apps from, named by its address.
store-fp-adds-source = Adicionar { $host } às suas fontes de aplicativos

# Last line, when the program asks for more than the lines above say.
store-fp-other = Mais outras configurações

store-fp-bluetooth = Dispositivos Bluetooth

store-fp-smartcard = Cartões inteligentes

store-fp-ssh = Suas chaves SSH

store-fp-gpg = Suas chaves GPG

store-fp-devel = Ferramentas de depuração, que permitem observar e controlar os programas que ele inicia

store-fp-session-bus = Todos os programas em execução na sua sessão

store-fp-system-bus = Todos os serviços deste computador

# A place the program can open and change; the place is given, as below.
store-fp-files = Abrir e alterar { $what }

# The same for a place it can only look at.
store-fp-files-read = Ver { $what }

store-fp-where-host = todos os arquivos deste computador

store-fp-where-system = os arquivos de sistema deste computador

store-fp-where-home = toda a sua pasta pessoal, com os arquivos ocultos

store-fp-where-path = a pasta { $path }

# A program on your session that it can talk to; the name is given.
store-fp-talk = Conversar com { $name }

# A service the program runs on your session.
store-fp-own = Executar o serviço { $name }

store-fp-talk-system = Conversar com o serviço do sistema { $name }

store-fp-own-system = Executar o serviço do sistema { $name }

# Said in red when Install failed and taking the program out again failed too.
store-fp-undo-failed = Ele pode ter ficado instalado pela metade.

# Said in red when a bundle could not be copied for a safe read.
store-fp-copy-failed = Não foi possível copiar o arquivo para lê-lo com segurança.
