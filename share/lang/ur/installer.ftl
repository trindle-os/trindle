# Red words on the last page when the snapshots could not be set up; { $why } is the reason.
installer-snapshots-failed = Trindle انسٹال ہو گیا ہے، لیکن وہ اسنیپ شاٹس سیٹ اپ نہیں کر سکا: { $why }

# Red words on the last page when the boot menu could not be made after setting up snapshots; { $why } is the reason.
installer-snapshots-menu-failed = Trindle انسٹال ہو گیا ہے، لیکن وہ اسنیپ شاٹس کو بوٹ مینو میں شامل نہیں کر سکا: { $why }

# Head of the card on the last page that lists what could not be done.
installer-done-problems = سب کچھ سیٹ اپ نہیں ہو سکا

# Red line under the disk password boxes: the computer gave no random numbers, so no passphrase could be made.
installer-suggest-failed = Trindle پاس فریز نہیں بنا سکا۔ اپنا خود لکھیں۔

# Red line at the foot: the disk was swapped for another after the list was read.
installer-disk-changed = { $dev } وہ ڈسک نہیں ہے جو دکھائی گئی تھی۔ پیچھے جائیں اور ڈسک دوبارہ چنیں۔

# Red line at the foot: a disk with an old-style partition table cannot be shared with.
installer-no-gpt = { $dev } میں GPT پارٹیشن ٹیبل نہیں ہے، اس لیے Trindle کو اس پر پہلے سے موجود چیزوں کے ساتھ انسٹال نہیں کیا جا سکتا۔

# Red line at the foot: the boot partition on the disk is too small to share.
installer-boot-partition-small = اس ڈسک پر بوٹ پارٹیشن شیئر کرنے کے لیے بہت چھوٹا ہے، اس لیے Trindle کو اس پر پہلے سے موجود چیزوں کے ساتھ انسٹال نہیں کیا جا سکتا۔

# Note on the last page: the swap file was not made, with why.
installer-swap-failed = Trindle انسٹال ہو گیا ہے، لیکن سواپ فائل نہیں بنا سکا: { $why }

# Red line at the foot: a partition's identity could not be read after it was made.
installer-uuid-missing = سیٹ اپ کرنے کے بعد Trindle { $dev } کی شناخت نہیں کر سکا۔

# Words on the last page: the disk that will be replaced, with what it holds.
installer-ready-replaced-known = { $disk } پر موجود ہر چیز بدل دی جائے گی ({ $holds })۔

# A disk named with its model and size, then its place such as /dev/sda.
installer-disk-named = { $what }، { $dev }

# Red line at the foot: a program the installer runs stopped before it had all it was given.
installer-run-stopped = { $program } اپنی ضرورت کی ساری چیزیں ملنے سے پہلے رک گیا: { $why }
