
# machine translated (Urdu), not yet reviewed by a person.

# Name of the Settings page about appearance, in the list and as its heading.
settings-appearance-title = ظاہری شکل

# Words a person might type into the Settings search to find the appearance page; separate them with spaces.
settings-appearance-keywords = رنگ رنگوں نمایاں تھیم تھیمز شکل ظاہری گلاس گہرا ہلکا موڈ دھوپ روشن آئیکن فونٹ کرسر پوائنٹر اسکرین ریڈر نابینا بلند خوانی رسائی لیبل ٹول ٹپ نام colour colours color colors accent theme themes look skin glass dark light mode sunshine bright icons font cursor pointer screen reader blind read aloud accessibility labels tooltips names pointing

# Introduction under the heading of the appearance page, and the words behind the page i.
settings-appearance-help = ہلکا یا گہرا موڈ، رنگ، آئیکن، فونٹ اور پوائنٹر چنیں، یا اسکرین پڑھنا چالو کریں۔ کچھ پروگرام دوبارہ کھولنے کے بعد ہی تبدیلی دکھاتے ہیں۔

# Question along the bottom of the page while a theme is on trial.
settings-appearance-foot-keep = یہ شکل رکھیں؟

# Small words beside the question along the bottom while a theme is on trial.
settings-appearance-foot-escape = Escape دبانے سے ابھی واپس ہو جائے گا۔

# Name of the dark look, on a theme's button and in the top sentence.
settings-appearance-look-dark = گہرا

# Name of the light look, on a theme's button and in the top sentence.
settings-appearance-look-light = ہلکا

# The dark look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-dark-lower = گہرا

# The light look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-light-lower = ہلکا

# Spoken name of a theme's Dark or Light button; { $name } is the theme and { $look } the look.
settings-appearance-theme-spoken = { $name }، { $look }

# Spoken description of the small picture of a theme; { $name } is the theme and { $look } its look, such as dark.
settings-appearance-sample-spoken = { $name } کیسا دکھتا ہے، { $look }

# Said aloud after Dark or Light was chosen; { $look } is dark or light.
settings-appearance-aloud-look = { $look } شکل۔

# Sentence at the top of the page when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-top-unusable = { $theme } تھیم استعمال نہیں ہو سکتی، اس لیے Trindle کی اپنی شکل استعمال میں ہے۔ { $why }

# Sentence at the top of the page for a theme that has dark and light looks; { $theme } is the theme, { $look } dark or light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme-look = { $theme } تھیم، { $look }، { $accent } نمایاں رنگ اور { $shape } آئیکن کے ساتھ۔

# Sentence at the top of the page for a theme with one look; { $theme } is the theme, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme = { $theme } تھیم، { $accent } نمایاں رنگ اور { $shape } آئیکن کے ساتھ۔

# Sentence at the top of the page when no theme is chosen; { $look } is Dark or Light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-look = { $look }، { $accent } نمایاں رنگ اور { $shape } آئیکن کے ساتھ۔

# Shape of the icons in the top sentence.
settings-appearance-shape-square = چوکور

# Shape of the icons in the top sentence.
settings-appearance-shape-round = گول

# Name of Trindle's own highlight colour, first in the list of colours.
settings-appearance-trindle-yellow = Trindle پیلا

# Start of the words behind the i of the reading the screen card.
settings-appearance-reading-says = یہ اسکرین پر موجود چیزیں اور جو آپ لکھتے ہیں وہ بلند آواز میں پڑھ کر سناتا ہے۔ اسے چالو یا بند کرنے کے لیے Super، Alt اور S اکٹھے دبائیں۔

# Red words under the icon shape line when the icons could not be remade.
settings-appearance-no-icons = Trindle تمام آئیکن اپڈیٹ نہیں کر سکا، اس لیے کچھ اب بھی اپنی پرانی شکل میں ہیں۔ دوبارہ کوشش کرنے کے لیے سیٹ پھر چنیں۔

# Small words on a theme's tile when Trindle made some of its colours clearer.
settings-appearance-corrected = Trindle نے کچھ متن پڑھنے میں آسان کر دیا۔

# Said aloud when a theme is tried; { $theme } is its name and { $seconds } how long until the old look comes back.
settings-appearance-aloud-trying =
    { $seconds ->
        [one] { $theme } تھیم آزمائی جا رہی ہے۔ آپ کی پچھلی شکل { $seconds } سیکنڈ میں واپس آ جائے گی، جب تک آپ رکھیں نہ دبائیں۔ ابھی واپس جانے کے لیے Escape دبائیں۔
       *[other] { $theme } تھیم آزمائی جا رہی ہے۔ آپ کی پچھلی شکل { $seconds } سیکنڈ میں واپس آ جائے گی، جب تک آپ رکھیں نہ دبائیں۔ ابھی واپس جانے کے لیے Escape دبائیں۔
    }

# Name of Trindle's own theme when none is named.
settings-appearance-trindle = Trindle

# Said aloud when a theme was kept; { $theme } is its name.
settings-appearance-aloud-kept = { $theme } تھیم رکھ لی گئی۔

# Red words under the Theme line when the old look could not be written back.
settings-appearance-back-failed = وقت ختم ہونے پر آپ کی پچھلی شکل واپس آ جائے گی۔

# Said aloud when the look from before is back.
settings-appearance-aloud-back = آپ کی پچھلی شکل واپس آ گئی۔

# Title of the window for choosing a theme file.
settings-appearance-chooser-title = تھیم چنیں

# Name of the filter in that window that shows only themes.
settings-appearance-chooser-filter = تھیمز

# Green words under the Add a theme line after a theme was added; { $name } is its name.
settings-appearance-added = { $name } اب اوپر کی فہرست میں ہے۔

# SAFETY: needs a human review before it ships
# Red words under the Theme line when a theme could not be removed.
settings-appearance-not-removed = تھیم ہٹائی نہیں جا سکی۔

# Red words under the theme tiles when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-cannot-use = Trindle { $theme } تھیم استعمال نہیں کر سکتا۔ { $why }

# SAFETY: needs a human review before it ships
# Name of the bin button that removes one of the person's own themes.
settings-appearance-remove-theme = یہ تھیم ہٹائیں

# Name of the button that chooses a theme; { $name } is the theme.
settings-appearance-use-theme = { $name } استعمال کریں

# Small words on a theme's tile naming its author; { $author } is the name.
settings-appearance-by = از { $author }

# Name of the button that adds a theme, and heading of its line.
settings-appearance-add-theme = تھیم شامل کریں

# Spoken name of the turning ring shown while themes are being found.
settings-appearance-looking = تھیمز تلاش ہو رہی ہیں

# Title of the Theme card.
settings-appearance-theme-card = تھیم

# Words behind the i of the Theme card.
settings-appearance-theme-about = تھیم ایک فائل میں پوری شکل ہے: رنگ، کونے، سائز اور فاصلے۔ کسی تھیم کو آزمانے کے لیے اسے دبائیں۔ Trindle کی ہر ونڈو ایک ساتھ بدل جاتی ہے۔ جب تک آپ رکھیں نہ دبائیں، آپ کی پچھلی شکل 30 سیکنڈ بعد خود واپس آ جاتی ہے، اس لیے آپ کبھی ایسی تھیم میں پھنسے نہیں رہتے جو پڑھی نہ جا سکے۔ اگر کسی تھیم میں گہری اور ہلکی دونوں شکلیں ہوں تو اس کی تصویر کے ساتھ گہرا اور ہلکا کے بٹن آ جاتے ہیں۔ ہلکا تیز دھوپ میں بہتر نظر آتا ہے، اور Apps سے آنے والی ایپس اگلی بار کھلنے پر اسے استعمال کرتی ہیں۔ ایک شکل والی تھیم میں یہ بٹن نہیں ہوتے۔ ہر تھیم میں آپ کا نمایاں رنگ آپ ہی کا رہتا ہے۔ آپ کی شامل کی ہوئی تھیم کو Trindle صرف پڑھتا ہے، کبھی چلاتا نہیں، اور پڑھنے میں مشکل الفاظ کو صاف کر دیتا ہے۔ ٹرمینل سے Trindle کی اپنی شکل واپس لانے کے لیے trindle-settings --theme default چلائیں۔

# Heading of the line holding the theme tiles.
settings-appearance-theme-line = تھیم

# Small words under the Add a theme line.
settings-appearance-add-theme-about = ایک .css فائل، جیسے کسی نے آپ کے ساتھ شیئر کی ہو۔

# Words of the link that opens help about what a theme file holds.
settings-appearance-theme-file-help = تھیم فائل میں کیا ہے

# Red words under the colour box when what was typed is not a colour.
settings-appearance-hex-bad = 0-9 اور a-f استعمال کریں، جیسے #fbc711۔

# Spoken description of the small dot that shows the colour typed.
settings-appearance-dot = آپ کا لکھا ہوا رنگ

# Placeholder of the box for typing a colour code.
settings-appearance-hex-code = ہیکس کوڈ

# Spoken name of the box for typing a colour as a hex code; the example is a code.
settings-appearance-hex-spoken = کوئی بھی رنگ، ہیکس کوڈ میں جیسے #fbc711

# Heading of the line for typing any colour.
settings-appearance-any-colour = کوئی بھی رنگ

# Small words under that line.
settings-appearance-any-colour-about = چھ یا آٹھ ہندسے، جیسے #fbc711۔

# Title of the Colour card.
settings-appearance-colour-title = رنگ

# Words behind the i of the Colour card.
settings-appearance-colour-about = نمایاں رنگ بٹنوں، سوئچوں، بھرتے ہوئے حلقے اور آپ کی موجودہ جگہ کو نشان زد کرتا ہے۔ Trindle کی اپنی ونڈوز فوراً بدل جاتی ہیں، اور حلقہ اگلی بار کھلنے پر بدلتا ہے۔ اگر کوئی رنگ کارڈ پر دیکھنے کے لیے بہت گہرا ہو تو Trindle اسے اتنا ہلکا کر دیتا ہے کہ پڑھا جا سکے۔ ہلکی شکل میں Trindle بہت پھیکے رنگ کو گہرا کر دیتا ہے۔ گہرا یا ہلکا تھیم کے اپنے ٹائل پر، تھیم کے نیچے چنیں۔

# Heading of the line with the highlight colour swatches.
settings-appearance-highlight = نمایاں رنگ

# Heading of the line, and name of its switch, for reading the screen aloud.
settings-appearance-reader = اسکرین بلند آواز میں پڑھیں

# Heading of the line, and name of its switch, for keeping labels while pointing.
settings-appearance-labels = اشارہ کرتے وقت لیبل رکھیں

# Title of the Reading the screen card.
settings-appearance-reading-title = اسکرین پڑھنا

# Words behind the i of that card; { $says } is the first sentences, from the key reading-says.
settings-appearance-reading-about = { $says } بٹن کا نام عام طور پر ڈیڑھ سیکنڈ بعد غائب ہو جاتا ہے۔ اگر آپ نام رکھنے کا انتخاب کریں تو وہ جب تک پوائنٹر بٹن پر ہو دکھائی دیتا ہے۔ جب اسکرین بلند آواز میں پڑھی جا رہی ہو تو ہر بٹن کے نیچے اس کا نام دکھائی دیتا ہے۔

# Name of the set of round icons.
settings-appearance-icons-circles = دائرے

# Name of the set of square icons.
settings-appearance-icons-squares = چوکور

# Words beside the turning ring while the icons are remade.
settings-appearance-icons-working = آئیکن بدلے جا رہے ہیں

# Green words under the shape line after the icons were remade.
settings-appearance-icons-changed = بدل گئے

# Name of the button that chooses an icon set; { $name } is the set, such as Circles.
settings-appearance-icons-set = { $name } آئیکن

# Heading of the line for the shape of the icons.
settings-appearance-shape = شکل

# Title of the Icons card.
settings-appearance-icons-title = آئیکن

# Words behind the i of the Icons card.
settings-appearance-icons-about = Trindle آئیکن گول یا چوکور شکل میں ملتے ہیں۔ اگر کسی ایپ کے لیے Trindle کے پاس آئیکن نہ ہو تو وہ ملتا جلتا آئیکن بنا لیتا ہے۔ حلقہ بھی نئی شکل استعمال کرتا ہے۔

# Name of the list of font families, and heading of the font line.
settings-appearance-font = فونٹ

# Name of the font line's choice before the font in use has been read, so a screen reader has a word to say.
settings-appearance-font-default = طے شدہ

# Name of the list of font sizes.
settings-appearance-font-size = فونٹ کا سائز

# Name of the button that adds fonts, and heading of its line.
settings-appearance-add-fonts = فونٹ شامل کریں

# Words of the link that opens help about what a font file must contain.
settings-appearance-fonts-help = فائل میں کیا ہونا چاہیے

# Title of the Text card.
settings-appearance-text-title = متن

# Words behind the i of the Text card.
settings-appearance-text-about = پروگراموں کے الفاظ کے لیے فونٹ اور سائز۔ یہاں آپ جو فونٹ شامل کریں، .ttf یا .otf فائلوں یا ان کی zip کی صورت میں، وہ صرف آپ کی فونٹ فہرست میں جاتے ہیں۔ کچھ پروگرام دوبارہ کھولنے کے بعد ہی انہیں دکھاتے ہیں۔

# Title of the window for choosing font files.
settings-appearance-chooser-fonts = فونٹ چنیں

# Red words when a font could not be replaced; { $name } is the file name.
settings-appearance-font-not-replaced = { $name } بدلا نہیں جا سکا۔

# Green words after one font took the place of the one there; { $name } is the file name.
settings-appearance-font-replaced-one = Trindle نے { $name } بدل دیا۔ اب سے آپ جو پروگرام شروع کریں گے وہ اسے استعمال کریں گے۔

# Green words after several fonts took the place of the ones there; { $n } of { $total } were done.
settings-appearance-font-replaced-some = Trindle نے { $total } میں سے { $n } فونٹ بدل دیے۔ اب سے آپ جو پروگرام شروع کریں گے وہ انہیں استعمال کریں گے۔

# Green words after fonts were added; { $n } is how many.
settings-appearance-fonts-added =
    { $n ->
        [one] { $n } فونٹ اب اوپر کی فہرست میں ہے۔
       *[other] { $n } فونٹ اب اوپر کی فہرست میں ہیں۔
    }

# Green words after added fonts were already in the list.
settings-appearance-fonts-in-list = یہ فونٹ پہلے ہی فہرست میں ہیں۔

# Choice in the list of cursor sizes: the normal size.
