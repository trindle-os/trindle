# machine translated (Urdu), not yet reviewed by a person.

# The page shown before a Flatpak program is installed, with what it will be able to reach.
# Headline over the page; the source of the program is given.
store-fp-headline-from = { $name } کو { $host } سے انسٹال کریں؟

# Headline over the page for a program that has been downloaded.
store-fp-headline = { $name } انسٹال کریں؟

# Name of the card that lists what the program will be able to reach.
store-fp-card = یہ کس چیز تک پہنچ سکے گا

# Tooltip of the round button that leaves without installing.
store-fp-cancel = انسٹال نہ کریں

# The main button.
store-fp-install = انسٹال کریں

# Said while Flatpak is being asked what the program wants.
store-fp-reading = دیکھا جا رہا ہے کہ یہ کیا مانگتا ہے…

# Red words when what the program asks for could not be read.
store-fp-unread = Trindle پڑھ نہیں سکا کہ یہ کیا مانگتا ہے۔

# Red words after Install was pressed once for a program whose list could not be read.
store-fp-unread-again = آگے بڑھنے کے لیے انسٹال کریں دوبارہ دبائیں۔

# Said when the program is already on this computer; the name is given.
store-fp-have = { $name } پہلے ہی انسٹال ہے۔

# Said when the program asks to reach nothing outside its own box.
store-fp-none = اپنے ڈبے سے باہر کچھ نہیں۔

# Each line below is one thing the program will be able to reach.
store-fp-network = انٹرنیٹ اور آپ کا مقامی نیٹ ورک

store-fp-x11 = دوسری ایپس کی ونڈوز، اور ان میں آپ جو ٹائپ کریں

store-fp-sound = آواز، اور آپ کا مائیکروفون

store-fp-devices = آپ کا کیمرا اور لگی ہوئی ہر دوسری ڈیوائس

store-fp-input = گیم کنٹرولر اور ان پٹ کی دوسری ڈیوائسیں

store-fp-kvm = تیز ورچوئل مشینیں

store-fp-shm = دوسری ایپس کے ساتھ مشترک میموری

store-fp-usb = USB ڈیوائسیں

store-fp-canbus = CAN bus ڈیوائسیں

store-fp-cups = آپ کے پرنٹر

store-fp-multiarch = 32 بٹ پروگرام چلانا

store-fp-escape = اس کمپیوٹر پر کوئی بھی پروگرام چلائیں

# A reference that also adds a second place to get apps from, named by its address.
store-fp-adds-source = { $host } کو اپنے ایپ ذرائع میں شامل کریں

# Last line, when the program asks for more than the lines above say.
store-fp-other = اور دوسری ترتیبات

store-fp-bluetooth = Bluetooth ڈیوائسیں

store-fp-smartcard = اسمارٹ کارڈ

store-fp-ssh = آپ کی SSH کیز

store-fp-gpg = آپ کی GPG کیز

store-fp-devel = ڈیبگنگ کے اوزار، جن سے یہ اپنے شروع کیے ہوئے پروگرام دیکھ اور چلا سکتا ہے

store-fp-session-bus = آپ کے سیشن میں چلنے والا ہر پروگرام

store-fp-system-bus = اس کمپیوٹر کی ہر سروس

# A place the program can open and change; the place is given, as below.
store-fp-files = { $what } کھولیں اور بدلیں

# The same for a place it can only look at.
store-fp-files-read = { $what } دیکھیں

store-fp-where-host = اس کمپیوٹر کی ہر فائل

store-fp-where-system = اس کمپیوٹر کی سسٹم فائلیں

store-fp-where-home = آپ کا پورا ہوم فولڈر، چھپی ہوئی فائلوں سمیت

store-fp-where-path = فولڈر { $path }

# A program on your session that it can talk to; the name is given.
store-fp-talk = { $name } سے بات کریں

# A service the program runs on your session.
store-fp-own = سروس { $name } چلائیں

store-fp-talk-system = سسٹم سروس { $name } سے بات کریں

store-fp-own-system = سسٹم سروس { $name } چلائیں

# Said in red when Install failed and taking the program out again failed too.
store-fp-undo-failed = ہو سکتا ہے یہ آدھا انسٹال ہوا ہو۔

# Said in red when a bundle could not be copied for a safe read.
store-fp-copy-failed = فائل کو محفوظ طریقے سے پڑھنے کے لیے کاپی نہیں کیا جا سکا۔
