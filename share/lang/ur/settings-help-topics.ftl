# Help topic "Adding fonts of your own": paragraph 1.
settings-help-topics-themes-p1 = سیٹنگز، ظاہری شکل میں آپ اپنا ڈاؤن لوڈ کیا ہوا فونٹ شامل کر سکتے ہیں، تاکہ آپ Trindle کے ساتھ آنے والے فونٹس تک محدود نہ رہیں۔ اسے متن کے تحت شامل کریں، اور وہ وہاں فونٹ کی فہرست میں ظاہر ہو جاتا ہے۔

# Help topic "Adding fonts of your own": paragraph 2.
settings-help-topics-themes-p2 = فونٹ ایک .ttf، .otf یا .ttc فائل ہوتی ہے، یا ان پر مشتمل zip۔ Trindle ملنے والے ہر فونٹ کو آپ کے اپنے فونٹس فولڈر میں کاپی کر دیتا ہے، اور وہ پھر فونٹ کی فہرست میں آ جاتے ہیں۔ اس کمپیوٹر کو استعمال کرنے والے ہر شخص کے لیے فونٹس انسٹال کرنے کے لیے اس کے بجائے Apps استعمال کریں۔

# Help topic "Adding fonts of your own": tip 3, shown in a box of its own.
settings-help-topics-themes-tip3 = جو کچھ آپ شامل کرتے ہیں وہ کہیں بھیجا نہیں جاتا، اور کمپیوٹر پر پہلے سے موجود کچھ بھی بدلا نہیں جاتا۔

# Title of the Help topic "Themes: a whole look from one file".
settings-help-topics-theme-files-title = تھیمز: ایک فائل سے پوری شکل

# Words people might search for the Help topic "Themes: a whole look from one file" by, in lower case, separated by spaces.
settings-help-topics-theme-files-keywords = تھیم ظاہری شکل فائل شامل شیئر بنائیں اپنا شیشہ گہرا ہلکا واپس جائیں تیس سیکنڈ محفوظ ڈیفالٹ آزمائش theme themes look skin file css add share make own glass dark light keep go back undo thirty seconds footer safe default trial

# Help topic "Themes: a whole look from one file": paragraph 1.
settings-help-topics-theme-files-p1 = تھیم ایک مکمل شکل ہے، جس میں رنگ، کونے، سائز اور فاصلے شامل ہیں، اور جو ایک فائل میں رکھی جاتی ہے۔ سیٹنگز، ظاہری شکل، تھیم میں ہر تھیم اس کے اپنے رنگوں سے بنی چھوٹی تصویر کی صورت میں دکھائی جاتی ہے۔ Trindle کی اپنی شکل، گہری نیلی رات، ہمیشہ فہرست میں پہلی ہوتی ہے اور کبھی ہٹائی نہیں جا سکتی۔ Midnight، جو Trindle کے ساتھ آتی ہے، سیاہ اور سرمئی ہے جس میں نیلا نہیں۔ Trindle کی اپنی شکل پہلے ایسی ہی ہوا کرتی تھی۔

# Help topic "Themes: a whole look from one file": step 1 of the numbered steps at block 2.
settings-help-topics-theme-files-step2-1 = آزمانے کے لیے ایک تھیم دبائیں۔ Trindle کی ہر ونڈو ایک دم بدل جاتی ہے۔ اگر کسی تھیم میں گہری اور ہلکی دونوں شکلیں ہوں تو اس کی تصویر کے ساتھ Dark اور Light ظاہر ہوتے ہیں۔ تھیم کو اس شکل میں آزمانے کے لیے اس کے بجائے ان میں سے ایک دبائیں۔ جو تھیم آپ پہلے سے استعمال کر رہے ہوں اس پر یہ شکل فوراً بدل دیتے ہیں، تصدیق کی ضرورت نہیں۔

# Help topic "Themes: a whole look from one file": step 2 of the numbered steps at block 2.
settings-help-topics-theme-files-step2-2 = ونڈو کے نیچے رکھیں کا ایک خانہ ظاہر ہوتا ہے۔ صفحے پر آپ کہیں بھی ہوں وہ نظر میں رہتا ہے۔ نئی شکل رکھنے کے لیے 30 سیکنڈ کے اندر رکھیں دبائیں۔ اگر آپ کچھ نہ کریں، یا ابھی واپس جائیں یا Escape دبائیں، تو آپ کی پہلے والی شکل خود واپس آ جاتی ہے، ہر جگہ، چاہے سیٹنگز بند ہو چکی ہو۔

# Help topic "Themes: a whole look from one file": step 3 of the numbered steps at block 2.
settings-help-topics-theme-files-step2-3 = کسی کی شیئر کی ہوئی تھیم شامل کرنے کے لیے تھیم شامل کریں دبائیں اور اس کی .css فائل چنیں۔ Trindle پہلے اسے جانچتا ہے۔ اگر وہ تھیم استعمال نہ کر سکے تو بتاتا ہے کہ کون سی سطر غلط ہے اور کیوں۔

# Help topic "Themes: a whole look from one file": paragraph 3.
settings-help-topics-theme-files-p3 = تھیم فائل Trindle کی اپنی شیٹ کی طرح لکھی جاتی ہے (اسٹائل شیٹ سے شکل بدلنا دیکھیں)۔ اس میں ایک :root { "{" } { "}" } بلاک ہوتا ہے جس میں انہی ناموں میں سے کوئی بھی ہو سکتا ہے، جیسے --trindle-page: #101820;۔ اوپر یہ بتا سکتی ہے کہ یہ کس کی ہے، --trindle-theme-name، --trindle-theme-about (ایک سطر)، --trindle-theme-author اور --trindle-theme-version کے ذریعے۔ یہ --trindle-theme-look: dark; light; یا both; سے بتا سکتی ہے کہ اس کی کون سی شکلیں ہیں۔ جو کچھ یہ چھوڑ دے وہ ویسا ہی رہتا ہے جیسا Trindle میں ہے۔ آپ کی شامل کی ہوئی تھیمز .config فولڈر کے اندر trindle فولڈر کے themes فولڈر میں رکھی جاتی ہیں۔ وہاں سے کوئی ہٹا دیں تو وہ فہرست سے بھی ہٹ جاتی ہے۔

# Help topic "Themes: a whole look from one file": paragraph 4.
settings-help-topics-theme-files-p4 = دونوں شکلوں والی تھیم انہیں ایک ہی فائل میں رکھتی ہے۔ اس کی گہری قدریں معمول کے مطابق :root { "{" } { "}" } میں لکھی جاتی ہیں، اور ہلکی قدریں دوسرے بلاک میں، @media (prefers-color-scheme: light) { "{" } :root { "{" } { "}" } { "}" }، بالکل جیسے Trindle کی اپنی شیٹ میں ہے۔ ہلکے بلاک میں ہر وہ رنگ اور سایہ دیں جو گہری شکل مقرر کرتی ہے، ورنہ گہری قدریں ہلکی شکل میں جھلکیں گی۔ پھر سیٹنگز تھیم کی تصویر کے ساتھ Dark اور Light دکھاتی ہے۔ جو تھیم dark یا light کہے اس کی صرف وہی ایک شکل ہوتی ہے، وہ ہمیشہ اسی میں دکھائی جاتی ہے، اور اس میں ایسے بٹن نہیں ہوتے۔ اگر تھیم کچھ نہ کہے تو Trindle اسے ہلکا بلاک ہونے پر دونوں شکلوں والی مانتا ہے، اور نہ ہونے پر گہری۔ دوسرے پروگراموں کو وہ شکل بتائی جاتی ہے جس میں آپ کی تھیم واقعی دکھائی جاتی ہے، اس لیے ہلکی تھیم انہیں ہلکا کر دیتی ہے۔

# Help topic "Themes: a whole look from one file": paragraph 5.
settings-help-topics-theme-files-p5 = تھیم آزمانا محفوظ ہے، چاہے کسی نے بھی بنائی ہو۔ Trindle اسے صرف قدروں کی فہرست کے طور پر پڑھتا ہے اور کبھی چلاتا نہیں، اور وہ کوئی دوسری فائل نہیں لا سکتی اور نہ انٹرنیٹ تک پہنچ سکتی ہے۔ Trindle صرف وہی قدریں لیتا ہے جنہیں وہ جانتا ہے، اور ہر ایک کو اس کی حدوں کے اندر رکھتا ہے۔ اس لیے کوئی تھیم بٹن، سوال یا وارننگ نہیں چھپا سکتی، اور نہ متن کو اتنا چھوٹا کر سکتی ہے کہ پڑھا نہ جائے۔ تھیم کوئی بھی رنگ دے، الفاظ پڑھنے کے قابل رہتے ہیں، سرخ سرخ ہی رہتا ہے، اور آپ کا نمایاں رنگ آپ ہی کا رہتا ہے۔ تھیم صرف آپ کی اپنی ونڈوز بدلتی ہے۔ لاگ ان اسکرین ہمیشہ Trindle کی اپنی شکل میں ہوتی ہے۔

# Help topic "Themes: a whole look from one file": tip 6, shown in a box of its own.
settings-help-topics-theme-files-tip6 = اگر کوئی شکل کبھی بگڑ جائے اور آپ واپسی کا راستہ نہ پائیں تو ٹرمینل کھولیں، یا Ctrl، Alt اور F3 سے ٹیکسٹ کنسول، اور لکھیں: trindle-settings --theme default

# Title of the Help topic "Changing the look with a style sheet".
settings-help-topics-theming-title = اسٹائل شیٹ سے شکل بدلنا

# Words people might search for the Help topic "Changing the look with a style sheet" by, in lower case, separated by spaces.
settings-help-topics-theming-keywords = تھیم اسٹائل شیٹ رنگ سائے کونے گول بڑا متن سائز بٹن پس منظر صفحہ اسٹور اپنی مرضی کا theme theming style sheet stylesheet css colours colors shadows corners rounder bigger text size buttons background page store look custom own retheme

# Help topic "Changing the look with a style sheet": paragraph 1.
settings-help-topics-theming-p1 = Trindle جو کچھ بناتا ہے وہ سب ایک اسٹائل شیٹ سے آتا ہے، جو ویب صفحات کی طرح لکھی جاتی ہے۔ اس میں رنگ، سائے، کونے، چیزوں کے درمیان جگہ، بٹنوں کا سائز، اور الفاظ کا سائز اور موٹائی شامل ہیں۔ آپ، یا کوئی AI جس سے آپ کہیں، اپنی شیٹ سے اس میں سے کچھ بھی بدل سکتا ہے۔

# Help topic "Changing the look with a style sheet": step 1 of the numbered steps at block 2.
settings-help-topics-theming-step2-1 = اپنے .config فولڈر کے اندر trindle فولڈر میں style.css نام کی فائل بنائیں۔ Folders اسے صرف تب دکھاتا ہے جب آپ چھپی فائلیں دکھائیں۔

# Help topic "Changing the look with a style sheet": step 2 of the numbered steps at block 2.
settings-help-topics-theming-step2-2 = صرف وہی ڈالیں جو بدلنا چاہتے ہیں، :root { "{" } { "}" } کے اندر۔ مثلاً --trindle-page: #101010; ہر ونڈو کو تقریباً سیاہ صفحہ دیتا ہے، --trindle-highlight: #4bae4f; بٹنوں کو سبز کرتا ہے، اور --trindle-card-corner: 16; کارڈز کو زیادہ گول کرتا ہے۔

# Help topic "Changing the look with a style sheet": step 3 of the numbered steps at block 2.
settings-help-topics-theming-step2-3 = اسے محفوظ کریں۔ Trindle کی ہر ونڈو، رنگ اور ٹائٹل بار فوراً بدل جاتے ہیں۔

# Help topic "Changing the look with a style sheet": paragraph 3.
settings-help-topics-theming-p3 = ہر وہ نام جو آپ استعمال کر سکتے ہیں Trindle کی اپنی شیٹ، /usr/share/trindle/style.css، میں درج ہے۔ ہر نام کے ساتھ ایک نوٹ ہے کہ وہ کیا کرتا ہے اور اس کی حدیں کیا ہیں، جیسے (6 سے 18)۔ صرف ہلکی شکل کی تبدیلیاں @media (prefers-color-scheme: light) { "{" } :root { "{" } { "}" } { "}" } بلاک ہی میں لکھی جاتی ہیں، جیسے Trindle کی شیٹ میں۔ سائے اسی طرح لکھے جاتے ہیں جیسے ویب صفحہ لکھتا ہے، مثلاً 0 8px 20px 2px rgba(0, 0, 0, 0.8)۔ کارڈز میں شروع میں ہلکا سایہ ہوتا ہے۔ --trindle-card-shadow: none; انہیں چپٹا کر دیتا ہے، اور --trindle-edge: transparent; ان کا باریک کنارہ ہٹا دیتا ہے۔

# Help topic "Changing the look with a style sheet": paragraph 4.
settings-help-topics-theming-p4 = آپ جو کچھ لکھیں اس سے کوئی ونڈو نہیں ٹوٹ سکتی۔ Trindle جن ناموں کو نہیں جانتا انہیں نظرانداز کرتا ہے، جو قدر پڑھ نہ سکے اس کی جگہ اپنی قدر لگا دیتا ہے، اور سائز ان کی حدوں کے اندر رکھتا ہے۔ رنگ آپ کی مرضی ہیں، اور Trindle انہیں بالکل ویسا ہی رکھتا ہے جیسا آپ نے لکھا۔ وہ اپنے الفاظ کا رنگ بدلتا ہے تاکہ وہ آپ کے صفحوں، کارڈز اور ٹائٹل بارز پر پڑھے جا سکیں۔ صرف ہلکی شکل کے لیے مقرر کیا ہوا رنگ صرف ہلکی شکل میں لاگو ہوتا ہے۔ شفاف رنگ کو سیاہ اور سفید دونوں پر جانچا جاتا ہے، کیونکہ Trindle نہیں جان سکتا کہ اس کے پار کیا دکھے گا۔ اگر الفاظ کا کوئی رنگ آپ کے سب رنگوں پر پڑھا نہ جا سکے تو Trindle سیاہ یا سفید استعمال کرتا ہے۔ تین چیزیں ہمیشہ پڑھنے کے قابل رہتی ہیں: ناکامی بتانے والے سرخ الفاظ، آپ کے نمایاں رنگ پر لکھے الفاظ، اور پاس ورڈ کے خانے، جو ہمیشہ Trindle کی اپنی شکل میں ہوتے ہیں۔ اگر آپ کے رنگ پڑھنے میں بہت مشکل ہوں تو سیٹنگز، ظاہری شکل "Some colours are hard to read." کہتی ہے اور انہیں ویسا ہی چھوڑ دیتی ہے جیسا آپ نے لکھا۔ اگر آپ کے اپنے مقرر کیے ہوئے الفاظ پڑھنے میں مشکل ہو جائیں تو فائل مٹا دیں اور Trindle کی اپنی شکل فوراً واپس آ جاتی ہے۔ فائل الفاظ کی عام (ٹیکسٹ) فائل ہونی چاہیے، زیادہ سے زیادہ 256 KB کی۔ اگر نہ ہو تو Trindle اسے استعمال نہیں کرتا، اور سیٹنگز، ظاہری شکل آپ کو بتاتی ہے۔

# Help topic "Changing the look with a style sheet": paragraph 5.
settings-help-topics-theming-p5 = آپ کی اپنی شیٹ چنی ہوئی کسی بھی تھیم کے اوپر لگتی ہے، اس لیے آپ کی چھوٹی سی تبدیلی تھیم بدلنے پر بھی رہتی ہے۔ اگر آپ پوری شکل بنانا چاہتے ہیں جسے رکھ سکیں یا شیئر کر سکیں تو اس کے بجائے تھیم بنائیں: تھیمز دیکھیں۔

# Help topic "Changing the look with a style sheet": tip 6, shown in a box of its own.
settings-help-topics-theming-tip6 = آپ کی شیٹ میں --trindle-highlight سے مقرر کردہ رنگ سیٹنگز، ظاہری شکل میں چنے ہوئے نمایاں رنگ پر غالب آتا ہے۔

# Title of the Help topic "Voice control".
settings-help-topics-voice-title = آواز سے کنٹرول

# Words people might search for the Help topic "Voice control" by, in lower case, separated by spaces.
settings-help-topics-voice-keywords = آواز بولیں بات مائیکروفون کمانڈز سنیں کہیں voice speak talk microphone commands whisper listen say

# Help topic "Voice control": paragraph 1.
settings-help-topics-voice-p1 = آواز سے کنٹرول ایک اختیاری اضافہ ہے۔ اسے شامل کرنے کے لیے سیٹنگز کھولیں، رنگ چنیں، اور آواز سے قابو شامل کریں دبائیں۔ اس میں چند منٹ اور تقریباً 150 MB لگتے ہیں۔

# Help topic "Voice control": paragraph 2.
settings-help-topics-voice-p2 = پھر رنگ کھولیں، جہاں کوئی بٹن نہ ہو وہاں اس کے بیچ میں ٹیپ کریں، اور بولیں۔ جب آپ بولنا بند کریں تو Trindle سننا بند کر دیتا ہے، یا آپ دوبارہ ٹیپ کر کے اسے روک سکتے ہیں۔ یہ ماؤس کے ساتھ ساتھ انگلی سے بھی کام کرتا ہے۔ آپ یہ باتیں کہہ سکتے ہیں:

# Help topic "Voice control": step 1 of the numbered steps at block 3.
settings-help-topics-voice-step3-1 = ایپ کا نام، جیسے “Firefox” یا “folders”۔

# Help topic "Voice control": step 2 of the numbered steps at block 3.
settings-help-topics-voice-step3-2 = کسی ایپ کی طرف “Switch to”، یا “close window”۔

# Help topic "Voice control": step 3 of the numbered steps at block 3.
settings-help-topics-voice-step3-3 = “Louder”، “quieter”، “mute”۔

# Help topic "Voice control": step 4 of the numbered steps at block 3.
settings-help-topics-voice-step3-4 = “Wi-Fi settings”، “battery settings”، یا سیٹنگز کا کوئی اور صفحہ۔

# Help topic "Voice control": step 5 of the numbered steps at block 3.
settings-help-topics-voice-step3-5 = “Install” اور ایپ کا نام، اسے Apps میں تلاش کرنے کے لیے۔

# Help topic "Voice control": step 6 of the numbered steps at block 3.
settings-help-topics-voice-step3-6 = “Next wallpaper”، “screenshot”، “what time is it”۔

# Help topic "Voice control": tip 4, shown in a box of its own.
