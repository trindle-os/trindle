# Said when typed words are not a change to a key.
common-remap-too-long = یہ ایک تبدیلی کے لیے بہت زیادہ کلیدیں ہیں۔

# Said when typed words are not a change to a key or a button.
common-no-equals = تبدیلی میں یہ ہونا چاہیے: جو دبایا جاتا ہے، ایک برابر کا نشان، اور وہ جو یہ بن جاتا ہے۔

# Said when typed words are not a change to a key.
common-remap-tapped-held = بتائیں کہ اسے ایک بار دبانے پر کیا ہو اور دبائے رکھنے پر کیا، جیسے Escape tapped, Ctrl held۔

# Said when typed words are not a change to a controller button.
common-pads-not-a-button = یہ Trindle کا جانا ہوا بٹن نہیں ہے۔ South، Left Trigger یا Escape آزمائیں۔

# Said when typed words are not a change to a controller.
common-pads-not-a-zone = ڈیڈ زون 0% سے 50% تک ہوتا ہے۔

# Said of a line in the controllers file that is not understood.
common-pads-not-a-heading = Trindle اس کنٹرولر کے عنوان کو نہیں پہچانتا۔

# Said of a line in the controllers file that is not understood.
common-pads-no-heading = یہ کسی کنٹرولر کے عنوان کے نیچے نہیں ہے۔

# What a theme's tile says when its file holds more than a theme may.
