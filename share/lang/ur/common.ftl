# Red words when the turn with the keyring could not be taken. { $why } is the system's reason.
common-keyring-turn-failed = Trindle کی رنگ تک رسائی حاصل نہیں کر سکا ({ $why })، اس لیے اس نے اسے استعمال نہیں کیا۔

# Line shown while the keyring has not answered whether it kept or removed a login or key. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
common-keyring-waiting =
    { $action ->
        [removing] کی رنگ نے ابھی جواب نہیں دیا، اس لیے { $what } ابھی ہٹایا نہیں گیا۔ اگر کی رنگ اسے بعد میں ہٹا دے تو یہ پیغام بتا دے گا۔
       *[other] کی رنگ نے ابھی جواب نہیں دیا، اس لیے { $what } ابھی محفوظ نہیں ہوا۔ اگر کی رنگ اسے بعد میں محفوظ کر لے تو یہ پیغام بتا دے گا۔
    }

# Line shown when the keyring answered late and did what was asked. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
common-keyring-late-done =
    { $action ->
        [removing] کی رنگ نے دیر سے جواب دیا، اور { $what } ہٹا دیا گیا ہے۔
       *[other] کی رنگ نے دیر سے جواب دیا، اور { $what } محفوظ ہو گیا ہے۔
    }

# Red words when the keyring never answered. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
common-keyring-late-never =
    { $action ->
        [removing] کی رنگ نے کبھی جواب نہیں دیا، اس لیے { $what } ہٹایا نہیں گیا۔
       *[other] کی رنگ نے کبھی جواب نہیں دیا، اس لیے { $what } محفوظ نہیں ہوا۔
    }

# Red words when the keyring answered late and would not do it. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping"; { $why } is the reason, as a sentence.
common-keyring-late-refused =
    { $action ->
        [removing] کی رنگ نے دیر سے جواب دیا اور { $what } نہیں ہٹایا: { $why }
       *[other] کی رنگ نے دیر سے جواب دیا اور { $what } محفوظ نہیں کیا: { $why }
    }

