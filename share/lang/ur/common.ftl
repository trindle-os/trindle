# Why a launcher was left alone: { $why } is the reason.
common-launcher-unchanged = کچھ نہیں بدلا گیا، کیونکہ { $why }۔

# The ring's notice when something is plugged in.
common-drive-arrived-usb = USB ڈرائیو جڑ گئی

