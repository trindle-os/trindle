common-more = مزید

common-more-spoken = اس کے بارے میں مزید، مدد کھلتی ہے



# First choice of "Ask for the password again after": the phone stays good for as long as it likes.
# SAFETY: needs a human review before it ships
common-pocketkey-never = کبھی نہیں

# A choice of "Ask for the password again after", and the time in the screen's label: { $n } hours.
common-pocketkey-hours =
    { $n ->
        [one] 1 گھنٹہ
       *[other] { $n } گھنٹے
    }

# A choice of "Ask for the password again after", and the time in the screen's label: { $n } days.
common-pocketkey-days =
    { $n ->
        [one] 1 دن
       *[other] { $n } دن
    }

# A choice of "Ask for the password again after", and the time in the screen's label: { $n } weeks.
common-pocketkey-weeks =
    { $n ->
        [one] 1 ہفتہ
       *[other] { $n } ہفتے
    }

# On the lock and login screens, when the time chosen has passed and the phone is not accepted: { $time } is such as "1 hour".
# SAFETY: needs a human review before it ships
common-pocketkey-due = { $time } سے زیادہ وقت گزر چکا ہے، اس لیے آپ کو اپنا پاس ورڈ دوبارہ لکھنا ہو گا۔

# Said under the greyed Earlier versions card.
common-snap-no-snapper = پرانے ورژن کے لیے snapper چاہیے، جو اس کمپیوٹر پر انسٹال نہیں ہے۔

# Said under the greyed Earlier versions card.
common-snap-from-snapshot = کمپیوٹر اسنیپ شاٹ سے شروع ہو تو یہ نہیں ہو سکتا۔

# Said under the greyed Earlier versions card.
common-snap-part-of-system = اس کمپیوٹر پر ہوم فولڈر نظام کا حصہ ہے، ڈسک کا اپنا الگ حصہ نہیں، اس لیے پرانے ورژن نظام سے الگ نہیں رکھے جا سکتے۔

# Said under the greyed Earlier versions card.
common-snap-network = ہوم فولڈر کسی دوسرے کمپیوٹر پر رکھا ہے، اس لیے پرانے ورژن یہاں نہیں رکھے جا سکتے۔

# Said under the greyed Earlier versions card: { $fs } is the kind of file system, such as ext4.
common-snap-not-btrfs = پرانے ورژن کے لیے ہوم فولڈر کا Btrfs پر ہونا ضروری ہے، اور یہاں یہ { $fs } پر ہے۔

# Said under the greyed Earlier versions card.
common-snap-not-whole = آپ کا ہوم فولڈر ڈسک کے کسی دوسرے حصے کے اندر ہے، اپنے الگ حصے پر نہیں، اس لیے Trindle اس کے پرانے ورژن نہیں رکھ سکتا۔

# Said under the greyed Earlier versions card.
common-snap-read-only = ہوم فولڈر میں اس وقت کچھ لکھا نہیں جا سکتا، اس لیے کچھ بھی رکھا نہیں جا سکتا۔

# Said under the greyed Earlier versions card.
common-snap-locked-files = یہاں ہوم فولڈر ایک مقفل فائل کی صورت میں رکھا ہے، اور ہر روز اس کی نقل ڈسک بھر دے گی۔

# Said under the greyed Earlier versions card.
common-snap-elsewhere = آپ کا ہوم فولڈر /home کے اندر نہیں ہے، جہاں نقلیں لی جاتی ہیں۔

# Said under the greyed Earlier versions card.
common-snap-apart = آپ کا ہوم فولڈر مقفل ہے یا دوسروں سے الگ رکھا ہے، اس لیے کاپیوں میں وہ شامل نہیں ہو سکتا۔

# Said under the greyed Earlier versions card.
common-snap-own-part = آپ کا ہوم فولڈر ڈسک کا اپنا الگ حصہ ہے، جس میں /home کی نقلیں نہیں جاتیں۔

# Why a plugin's port line in plugin.ini is refused. { $text } is what was written.
common-firewall-not-protocol-port = "{ $text }" protocol:port کی شکل میں نہیں لکھا گیا، جیسے tcp:24810۔

# Why a plugin's port line in plugin.ini is refused. { $text } is what was written before the colon.
common-firewall-bad-protocol = "{ $text }" نہ tcp ہے نہ udp۔ اسے چھوٹے حروف میں لکھیں۔

# Why a plugin's port line in plugin.ini is refused. { $text } is what was written, { $lowest } the lowest port allowed.
common-firewall-bad-port = "{ $text }" { $lowest } سے 65535 تک کا پورٹ نہیں ہے۔

# Said when a port you open by hand isn't written as protocol:port.
common-firewall-own-form = اسے protocol:port کی شکل میں لکھیں، جیسے tcp:37666۔

# Said when a port you open by hand starts with something other than tcp or udp.
common-firewall-own-protocol = tcp یا udp استعمال کریں۔

# Said when a port you open by hand isn't a number from 1 to 65535.
common-firewall-own-port = یہ 1 سے 65535 تک کا پورٹ نہیں ہے۔

# Joins the last port to the others in a list of ports. { $first } is the others, comma separated.
common-firewall-and = { $first } اور { $last }

# Heads a list of ports. { $count } is how many, { $list } is the ports, such as TCP 24810 and UDP 24811.
common-firewall-ports =
    { $count ->
        [one] پورٹ { $list }
       *[other] پورٹس { $list }
    }

# Why a plugin's ports are refused. { $max } is the most it may name.
common-firewall-too-many = ایک پلگ ان زیادہ سے زیادہ { $max } پورٹس کا نام لے سکتا ہے۔

# Why a plugin's ports are refused. { $port } is a port such as TCP 24810.
common-firewall-twice = { $port } کا نام دو بار آیا ہے۔

# Why a plugin's ports are refused. { $port } is a port such as TCP 80, { $lowest } the lowest allowed.
common-firewall-too-low = { $port } { $lowest } سے نیچے ہے۔ وہ پورٹس سسٹم کے لیے رکھے گئے ہیں۔

# Why a plugin's port is refused. { $port } is the number.
common-firewall-reserved = پورٹ { $port } Trindle یا کسی عام سروس کے استعمال میں ہے، اس لیے پلگ ان اسے نہیں مانگ سکتا۔

# Why a plugin's port can't be opened. { $port } is such as TCP 24810, { $plugin } is the other plugin's name.
common-firewall-taken = { $port } پہلے ہی { $plugin } کے استعمال میں ہے، اس لیے اسے اس پلگ ان کے لیے بھی نہیں کھولا جا سکتا۔

# Why a plugin cannot open another port: { $max } is how many may be open.
common-firewall-full = پلگ انز کے لیے جتنے پورٹس کھل سکتے ہیں، یعنی { $max }، وہ پہلے ہی کھلے ہیں۔

# Told by a notice when the ring has been started again.
common-ring-held-back = حلقہ لگاتار کئی بار رکا، اس لیے Trindle نے اسے کچھ دیر کے لیے روک دیا۔ اب وہ دوبارہ چل رہا ہے۔

# Told by a notice when the ring has been started again.
common-ring-not-started = حلقہ کچھ دیر تک شروع نہیں ہو سکا۔ اب یہ دوبارہ چل رہا ہے۔

# Told by a notice when the ring has been started again.
common-ring-not-ended = حلقے نے جواب دینا چھوڑ دیا اور کچھ دیر تک اسے بند نہیں کیا جا سکا۔ اب یہ دوبارہ چل رہا ہے۔

# Told by a notice.
common-ring-not-done = کمپیوٹر کو سسپینڈ، ری اسٹارٹ یا بند کرنے کو کہا گیا تھا اور اس نے ایسا نہیں کیا۔

# Told by a notice; the ring is what the round menu is called.
common-ring-by-name = ڈیسک ٹاپ اس حلقے کو خود شروع نہیں کر سکا، اس لیے یہ پوری اسکرین والی ونڈو کے اوپر نہیں کھل سکتا اور اس کے نوٹس سب سے اوپر نہیں رہتے۔ لاگ آؤٹ کر کے دوبارہ لاگ ان کرنے سے شاید ٹھیک ہو جائے۔

