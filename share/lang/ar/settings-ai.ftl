
# machine translated (Arabic), not yet reviewed by a person.

# Name of the AI programs page, in the page list, as its heading and on the card listing the programs.
settings-ai-title = برامج الذكاء الاصطناعي

# Words people may search for to find the AI programs page, separated by spaces.
settings-ai-keywords = ذكاء اصطناعي برامج وكيل سياج عزل مجلدات خاصة مشاركة مفاتيح ai programs claude codex cursor gemini aider agent fence sandbox private folders share ssh keys token sudo

# Help line at the foot of the AI programs page.
settings-ai-help = تعمل برامج البرمجة بالذكاء الاصطناعي داخل سياج يخفي ملفاتك الشخصية. شارك فقط المجلدات التي تحتاجها.

# SAFETY: needs a human review before it ships
# Headline of the AI programs page.
settings-ai-note = في الاستخدام اليومي، يُبعد هذا برامج الذكاء الاصطناعي عن ملفاتك الشخصية. فهو يمنع مثلًا برنامجًا خُدع من جمع كشوف حسابك المصرفي وإرسالها. للحماية حدود وهي ليست ضمانًا. قد يتسرب شيء ما إن كان البرنامج مصرًّا، أو كان في برمجيات الحاسوب خلل، أو وافقتَ على طلب أو شاركتَ مجلدًا.

# SAFETY: needs a human review before it ships
# Note under the headline of the AI programs page.
settings-ai-inside = كل ما يبدؤه برنامج ذكاء اصطناعي، مثل البرامج المثبّتة والنصوص البرمجية، يبقى معه داخل السياج.

# Red words when a change to the fence could not be made.
settings-ai-not-changed = تعذّر تغيير ذلك.

# Said beside a setting on the AI programs page once it is saved.
settings-ai-saved = تم الحفظ

# SAFETY: needs a human review before it ships
# Title of the window for choosing a folder to share with AI programs.
settings-ai-choose-folder = اختر مجلدًا لمشاركته مع برامج الذكاء الاصطناعي

# Red words when the key for AI programs to reach computers by ssh could not be made.
settings-ai-key-not-made = تعذّر إنشاء المفتاح.

# SAFETY: needs a human review before it ships
# Label of the switch that limits the network of AI programs, and heading of its line.
settings-ai-limit-net = السماح بالمواقع أدناه فقط

# SAFETY: needs a human review before it ships
# Tip of the button that removes a site from the list AI programs may reach.
settings-ai-stop-site = منع برامج الذكاء الاصطناعي من الوصول إلى هذا الموقع

# Example in the box for typing a site AI programs may reach.
settings-ai-eg-site = api.anthropic.com

# SAFETY: needs a human review before it ships
# Tip of the button that adds a site AI programs may reach.
settings-ai-let-site = السماح لبرامج الذكاء الاصطناعي بالوصول إلى هذا الموقع

# SAFETY: needs a human review before it ships
# Heading of the line for adding a site.
settings-ai-add-site = إضافة موقع

# Under the Add a site heading.
settings-ai-add-site-sub = اكتب اسمه، أو *.example.com لكل المواقع تحته.

# Heading of the card that limits the network of AI programs.
settings-ai-network = الشبكة

# SAFETY: needs a human review before it ships
# Help text of the Network card (the information button).
settings-ai-network-about = عندما يكون هذا متوقفًا، تستخدم برامج الذكاء الاصطناعي الشبكة كما تستخدمها أنت. وعندما يكون يعمل، لا تصل إلا إلى المواقع أدناه عبر اتصالات آمنة (https)، ولا تكون للسياج شبكة خاصة به. يجب أن تستخدم أدوات البرنامج إعدادات الوكيل (proxy) المعطاة لها. أضف موقع خدمة الذكاء الاصطناعي، وأي مصدر حزم يحتاجه التثبيت.

# SAFETY: needs a human review before it ships
# Label of the switch that keeps AI programs inside the fence, and heading of its line.
settings-ai-keep-inside = إبقاء برامج الذكاء الاصطناعي داخل السياج

# SAFETY: needs a human review before it ships
# Under the fence switch when it is off.
settings-ai-fence-off = السياج متوقف. تستطيع برامج الذكاء الاصطناعي الآن رؤية كل ما تراه أنت.

# Heading of the card with the fence switch.
settings-ai-the-fence = السياج

# Help text of The fence card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-fence-about = يبقى النظام ظاهرًا لبرامج الذكاء الاصطناعي وقابلًا للاستخدام. وبدلًا من مجلدك الرئيسي، تحصل على مجلد خاص يبدأ فارغًا ويُحفظ بين التشغيلات. لا تظهر فيه إلا المجلدات التي تشاركها. لا تستطيع رؤية برامجك الأخرى ولا جلستك ولا مفاتيحك ولا كلمات مرورك. والبرنامج الذي تشغّله بطريقة أخرى، لا باسمه في هذه القائمة، لا يكون داخل السياج.

# SAFETY: needs a human review before it ships
# Label of the switch that fences one AI program: its name is { $name }.
settings-ai-fence-name = وضع { $name } داخل السياج

# SAFETY: needs a human review before it ships
# Tip of the button that takes one program off the list: its name is { $name }.
settings-ai-take-off = إزالة { $name } من القائمة

# SAFETY: needs a human review before it ships
# Label of the switch for using a program's existing settings folder: its name is { $name }.
settings-ai-own-for = استخدام مجلد إعداداتي الحالي لـ { $name }

# SAFETY: needs a human review before it ships
# Heading of the line with the switch for using a program's existing settings folder.
settings-ai-own = استخدام مجلد إعداداتي الحالي

# Under the existing settings folder heading.
settings-ai-own-sub = يحوي هذا المجلد محادثات البرنامج السابقة.

# Example in the box for typing the name of an AI program.
settings-ai-eg-program = claude

# Tip of the button that adds an AI program, and heading of its line.
settings-ai-add-program = إضافة برنامج

# SAFETY: needs a human review before it ships
# Help text of the AI programs card (the information button).
settings-ai-programs-about = تبدأ هذه البرامج داخل السياج. إذا كان خيار "استخدام مجلد إعداداتي الحالي" متوقفًا، يبدأ البرنامج بمجلد خاص جديد. يسجّل كل برنامج الدخول بنفسه داخل السياج. ولا يُشارَك تسجيل دخولك.

# Heading of the line shown when no folder is shared with AI programs.
settings-ai-nothing-shared = لا شيء مشارك

# SAFETY: needs a human review before it ships
# Label of the switch that lets AI programs only read a shared folder.
settings-ai-only-read = السماح بالقراءة فقط في هذا المجلد

# SAFETY: needs a human review before it ships
# Tip of the button that stops sharing a folder with AI programs.
settings-ai-make-private = جعل هذا المجلد خاصًا من جديد

# Under a shared folder's path, beside the switch that makes it read only.
settings-ai-only-read-short = القراءة فقط

# SAFETY: needs a human review before it ships
# Tip of the button that shares a folder, and heading of its line.
settings-ai-share-folder = مشاركة مجلد

# Under the Share a folder heading.
settings-ai-share-folder-sub = يظهر في المكان نفسه. تستطيع برامج الذكاء الاصطناعي القراءة منه والكتابة فيه.

# Heading of the card listing folders shared with AI programs.
settings-ai-shared = مشارك مع برامج الذكاء الاصطناعي

# SAFETY: needs a human review before it ships
# Help text of the shared folders card (the information button).
settings-ai-shared-about = يبقى كل مجلد آخر في مجلدك الرئيسي خاصًا عن برامج الذكاء الاصطناعي. ولا يمكنك أبدًا مشاركة المجلدات المخفية، ولا المجلدات التي تحفظ مفاتيح أو كلمات مرور أو بريدًا. المجلد الذي تشاركه هنا يكون متاحًا عند بدء البرنامج في المرة التالية.

# SAFETY: needs a human review before it ships
# Tip of the button that removes a computer from the list AI programs may reach by ssh.
settings-ai-stop-computer = منع برامج الذكاء الاصطناعي من الوصول إلى هذا الحاسوب

# Example in the box for typing a computer AI programs may reach by ssh.
settings-ai-eg-computer = nas.local

# SAFETY: needs a human review before it ships
# Tip of the button that adds a computer AI programs may reach by ssh.
settings-ai-let-computer = السماح لبرامج الذكاء الاصطناعي بالوصول إلى هذا الحاسوب

# SAFETY: needs a human review before it ships
# Heading of the line for adding a computer.
settings-ai-add-computer = إضافة حاسوب

# Note showing the public key to put on each computer: the key is { $key }.
settings-ai-put-key = ضع هذا المفتاح على كل حاسوب: { $key }

# SAFETY: needs a human review before it ships
# Tip of the button that makes a key for AI programs.
settings-ai-make-key = إنشاء المفتاح

# SAFETY: needs a human review before it ships
# Heading of the line for making a key for AI programs.
settings-ai-make-key-for = إنشاء مفتاح لبرامج الذكاء الاصطناعي

# Under the Make a key heading.
settings-ai-make-key-sub = مفتاح منفصل، محفوظ خارج المجلدات التي تستطيع برامج الذكاء الاصطناعي رؤيتها.

# Heading of the card listing computers AI programs may reach by ssh.
settings-ai-ssh = الحواسيب التي يمكنها الوصول إليها عبر ssh

# SAFETY: needs a human review before it ships
# Help text of the ssh card (the information button).
settings-ai-ssh-about = داخل السياج، يتصل ssh عبر Trindle. يستخدم Trindle مفتاحًا خاصًا به، وللحواسيب المدرجة هنا فقط. لا ترى برامج الذكاء الاصطناعي مفاتيحك الخاصة أبدًا.

# SAFETY: needs a human review before it ships
