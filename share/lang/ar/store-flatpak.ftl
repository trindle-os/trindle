# machine translated (Arabic), not yet reviewed by a person.

# The page shown before a Flatpak program is installed, with what it will be able to reach.
# Headline over the page; the source of the program is given.
store-fp-headline-from = تثبيت { $name } من { $host }؟

# Headline over the page for a program that has been downloaded.
store-fp-headline = تثبيت { $name }؟

# Name of the card that lists what the program will be able to reach.
store-fp-card = ما سيستطيع الوصول إليه

# Tooltip of the round button that leaves without installing.
store-fp-cancel = لا تثبّت

# The main button.
store-fp-install = تثبيت

# Said while Flatpak is being asked what the program wants.
store-fp-reading = جارٍ قراءة ما يطلبه…

# Red words when what the program asks for could not be read.
store-fp-unread = تعذّرت على Trindle قراءة ما يطلبه.

# Red words after Install was pressed once for a program whose list could not be read.
store-fp-unread-again = اضغط تثبيت مرة أخرى للمتابعة.

# Said when the program is already on this computer; the name is given.
store-fp-have = { $name } مثبّت بالفعل.

# Said when the program asks to reach nothing outside its own box.
store-fp-none = لا شيء خارج صندوقه الخاص.

# Each line below is one thing the program will be able to reach.
store-fp-network = الإنترنت وشبكتك المحلية

store-fp-x11 = نوافذ التطبيقات الأخرى، وما تكتبه فيها

store-fp-sound = الصوت والميكروفون

store-fp-devices = الكاميرا وكل جهاز آخر موصول

store-fp-input = أجهزة التحكم في الألعاب وأجهزة الإدخال الأخرى

store-fp-kvm = الأجهزة الافتراضية السريعة

store-fp-shm = ذاكرة مشتركة مع التطبيقات الأخرى

store-fp-usb = أجهزة USB

store-fp-canbus = أجهزة CAN bus

store-fp-cups = طابعاتك

store-fp-multiarch = تشغيل برامج 32 بت

store-fp-escape = تشغيل أي برنامج على هذا الحاسوب

# A reference that also adds a second place to get apps from, named by its address.
store-fp-adds-source = إضافة { $host } إلى مصادر تطبيقاتك

# Last line, when the program asks for more than the lines above say.
store-fp-other = بالإضافة إلى إعدادات أخرى

store-fp-bluetooth = أجهزة Bluetooth

store-fp-smartcard = البطاقات الذكية

store-fp-ssh = مفاتيح SSH الخاصة بك

store-fp-gpg = مفاتيح GPG الخاصة بك

store-fp-devel = أدوات تصحيح الأخطاء، وتتيح له مراقبة البرامج التي يشغّلها والتحكم فيها

store-fp-session-bus = كل برنامج يعمل في جلستك

store-fp-system-bus = كل خدمة على هذا الحاسوب

# A place the program can open and change; the place is given, as below.
store-fp-files = فتح { $what } وتعديله

# The same for a place it can only look at.
store-fp-files-read = الاطلاع على { $what }

store-fp-where-host = كل ملف على هذا الحاسوب

store-fp-where-system = ملفات النظام في هذا الحاسوب

store-fp-where-home = مجلدك الشخصي كله، بما فيه الملفات المخفية

store-fp-where-path = المجلد { $path }

# A program on your session that it can talk to; the name is given.
store-fp-talk = التواصل مع { $name }

# A service the program runs on your session.
store-fp-own = تشغيل الخدمة { $name }

store-fp-talk-system = التواصل مع خدمة النظام { $name }

store-fp-own-system = تشغيل خدمة النظام { $name }

# Said in red when Install failed and taking the program out again failed too.
store-fp-undo-failed = قد يكون مثبّتًا جزئيًا.

# Said in red when a bundle could not be copied for a safe read.
store-fp-copy-failed = تعذّر نسخ الملف لقراءته بأمان.
