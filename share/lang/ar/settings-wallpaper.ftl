
# machine translated (Arabic), not yet reviewed by a person.

# Name of the Settings page about the wallpaper, in the list and as its heading.
settings-wallpaper-title = الخلفية

# Words a person might type into the Settings search to find the wallpaper page; separate them with spaces.
settings-wallpaper-keywords = خلفية صورة عرض شرائح صور شاشة سطح المكتب

# Introduction under the heading of the wallpaper page, and the words behind the page i.
settings-wallpaper-help = استخدم لونًا واحدًا، أو صورة واحدة، أو مجلد صور تتغير بالمعدل الذي تختاره.

# Choice in the list of how long each picture stays.
settings-wallpaper-every-10s = 10 ثوانٍ

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30s = 30 ثانية

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1m = دقيقة واحدة

# Choice in the list of how long each picture stays.
settings-wallpaper-every-5m = 5 دقائق

# Choice in the list of how long each picture stays.
settings-wallpaper-every-15m = 15 دقيقة

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30m = 30 دقيقة

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1h = ساعة واحدة

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1d = يوم واحد

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fill = ملء الشاشة

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fit = ملاءمة الصورة كاملة

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-center = في الوسط، بالحجم الفعلي

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-stretch = تمديد

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-tile = تبليط

# Choice in the list of the order pictures change in: at random.
settings-wallpaper-order-shuffle = عشوائي

# Choice in the list of the order pictures change in: by file name.
settings-wallpaper-order-name = حسب اسم الملف

# Red words when the program that draws the wallpaper would not start.
settings-wallpaper-no-changer = لم يستطع Trindle تشغيل البرنامج الذي يغيّر الخلفية.

# Under the large picture, when counting; { $used } of { $all } pictures are used.
settings-wallpaper-count =
    { $all ->
        [zero] { $used } من { $all } صورة
        [one] { $used } من صورة واحدة
        [two] { $used } من صورتين
        [few] { $used } من { $all } صور
        [many] { $used } من { $all } صورة
       *[other] { $used } من { $all } صورة
    }

# Under the large picture; { $folder } is a folder with no pictures in it.
settings-wallpaper-empty-folder = لا توجد صور في { $folder }

# Under the large picture, for the pictures that come with Trindle; { $used } of { $all } are used.
settings-wallpaper-count-own =
    { $all ->
        [zero] { $used } من { $all } صورة من صور Trindle
        [one] { $used } من صورة واحدة تأتي مع Trindle
        [two] { $used } من صورتين تأتيان مع Trindle
        [few] { $used } من { $all } صور تأتي مع Trindle
        [many] { $used } من { $all } صورة تأتي مع Trindle
       *[other] { $used } من { $all } صورة تأتي مع Trindle
    }

# Under the large picture, for a folder; { $used } of { $all } pictures are used and { $folder } is the folder.
settings-wallpaper-count-folder =
    { $all ->
        [zero] { $used } من { $all } صورة من { $folder }
        [one] { $used } من صورة واحدة من { $folder }
        [two] { $used } من صورتين من { $folder }
        [few] { $used } من { $all } صور من { $folder }
        [many] { $used } من { $all } صورة من { $folder }
       *[other] { $used } من { $all } صورة من { $folder }
    }

# Under the large picture, for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own = { $name }، إحدى الصور التي تأتي مع Trindle

# Under the large picture when there is only a colour.
settings-wallpaper-plain-below = لون ساده، يُضبط أدناه.

# Under the large picture when the picture or folder has gone.
settings-wallpaper-gone-below = الصورة أو المجلد لم يعد موجودًا. اختر غيره.

# Sentence about the wallpaper when it is a plain colour.
settings-wallpaper-plain = لون واحد فقط.

# Sentence about the wallpaper when Trindle's own pictures change; { $every } is how often, { $used } of { $all } pictures are used and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-own =
    { $all ->
        [zero] صورة جديدة كل { $every }، من { $used } من صور Trindle.{ $extra }
        [one] صورة جديدة كل { $every }، من { $used } من الصورة الواحدة التي تأتي مع Trindle.{ $extra }
        [two] صورة جديدة كل { $every }، من { $used } من الصورتين اللتين تأتيان مع Trindle.{ $extra }
        [few] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } التي تأتي مع Trindle.{ $extra }
        [many] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } التي تأتي مع Trindle.{ $extra }
       *[other] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } التي تأتي مع Trindle.{ $extra }
    }

# Sentence about the wallpaper when a folder's pictures change; { $every } is how often, { $used } of { $all } pictures are used, { $folder } is the folder's name and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-folder =
    { $all ->
        [zero] صورة جديدة كل { $every }، من { $used } من صور { $folder }.{ $extra }
        [one] صورة جديدة كل { $every }، من { $used } من الصورة الواحدة في { $folder }.{ $extra }
        [two] صورة جديدة كل { $every }، من { $used } من الصورتين في { $folder }.{ $extra }
        [few] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } في { $folder }.{ $extra }
        [many] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } في { $folder }.{ $extra }
       *[other] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } في { $folder }.{ $extra }
    }

# Sentence about the wallpaper when its folder has no pictures; { $folder } is the folder.
settings-wallpaper-empty-folder-choose = لا توجد صور في المجلد { $folder }. اختر مجلدًا آخر.

# Added to the sentence about the wallpaper when a folder holds more than Trindle looks through.
settings-wallpaper-more-than-looked-at = يحتوي المجلد على صور أكثر مما يستطيع Trindle فحصه، لذلك قد يُترك بعضها.

# Sentence about the wallpaper for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own-said = { $name }، إحدى الصور التي تأتي مع Trindle.

# Sentence about the wallpaper for one chosen picture; { $name } is its name, written to read in the middle of a sentence.
settings-wallpaper-file-one = { $name } تُعرض دائمًا.

# Sentence about the wallpaper when the chosen picture cannot be used; { $why } is the reason.
settings-wallpaper-file-refused = لا يستخدم Trindle تلك الصورة. { $why } وتُعرض صورة Trindle الخاصة بدلًا منها.

# Sentence about the wallpaper when the picture has gone.
settings-wallpaper-file-gone = الصورة لم تعد موجودة. اختر صورة أو مجلدًا.

# Said in green under a line after its choice was kept.
settings-wallpaper-saved = تم الحفظ

# Said in green under the next picture line after the picture changed.
settings-wallpaper-changed = تم التغيير

# Small word drawn in the corner of a moving picture's tile.
settings-wallpaper-animated = متحركة

